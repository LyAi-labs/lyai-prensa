# syntax=docker/dockerfile:1.6

FROM python:3.12-slim
WORKDIR /app

COPY requirements.txt constraints-api.txt ./
RUN pip install --no-cache-dir -r requirements.txt -c constraints-api.txt

# Crear usuario sin privilegios y directorio de caché
RUN useradd -u 10001 -m -s /bin/sh appuser \
    && mkdir -p /tmp/prensa_image_cache \
    && chown -R appuser:appuser /app /tmp/prensa_image_cache

COPY --chown=appuser:appuser pipeline ./pipeline
COPY --chown=appuser:appuser api ./api
COPY --chown=appuser:appuser docs ./docs

USER appuser

EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
