    "node_71b5219b9aa0": {
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=JetBrains+Mono:wght@400;500&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css\");\n\n.ff-ui { font-family: 'Libre Franklin', system-ui, sans-serif; }\n.ff-read { font-family: 'Newsreader', Georgia, serif; }\n.ff-mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }\n\n.ar-field { user-select: none; -webkit-user-select: none; }\n/* El archivo arranca a la derecha de la mesa: la mesa no tapa nada al entrar. */\n.ar-band { will-change: transform; cursor: grab; padding-left: 868px; }\n.ar-band:active { cursor: grabbing; }\n\n/* Procedencia del medio: un cuadrado pequeño, nunca una franja lateral. */\n.ar-swatch { width: 8px; height: 8px; flex: none; background: var(--medio); }\n.ar-swatch-lg { width: 10px; height: 10px; flex: none; background: var(--medio); }\n\n/* Corchete de origen: marca en el archivo la noticia que abrió la mesa. */\n.ar-origen { position: relative; }\n.ar-origen::before,\n.ar-origen::after {\n  content: ''; position: absolute; left: -14px; width: 8px; height: 1px; background: #35D6E8;\n}\n.ar-origen::before { top: 0; }\n.ar-origen::after { bottom: 0; }\n.ar-origen > .ar-origen-spine {\n  position: absolute; left: -14px; top: 0; bottom: 0; width: 1px; background: #35D6E8;\n}\n\n/* Regla de intensidad con escala explícita de 0 a 1, sobre papel. */\n.ar-ruler { position: relative; height: 18px; }\n.ar-ruler-track { position: absolute; left: 0; right: 0; top: 8px; height: 1px; background: #B9B2A5; }\n.ar-ruler-tick { position: absolute; top: 3px; width: 1px; height: 6px; background: #B9B2A5; }\n.ar-ruler-needle { position: absolute; top: 0; width: 2px; height: 17px; background: #15171A; }\n\n\n/* Cada titular del archivo es un destino. La canal es PERMANENTE: se ve en\n   reposo, también con el dedo, donde no existe el hover. */\n.ar-entry { position: relative; padding-left: 14px; cursor: pointer; text-decoration: none; }\n.ar-entry::before {\n  content: ''; position: absolute; left: 0; top: -2px; bottom: -2px; width: 1px;\n  background: #2A3039; transition: background .18s ease, width .18s ease;\n}\n.ar-entry:hover::before, .ar-entry:focus-visible::before { background: #E6E2DA; width: 2px; }\n.ar-entry:hover .ar-ttl { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; text-decoration-color: #6B7079; }\n.ar-entry:focus-visible { outline: 1px solid #35D6E8; outline-offset: 5px; }\n/* La noticia que está sobre la mesa conserva su corchete: es el estado abierto. */\n.ar-origen { cursor: pointer; }\n\n.ar-photo { filter: grayscale(0.4) contrast(1.06) brightness(0.74); }\n</style>\n\n<div data-name=\"pantalla del archivo y la mesa\" class=\"ff-ui w-full h-[900px] bg-[#08090B] text-[#E6E2DA] flex flex-col overflow-hidden antialiased\" data-kid=\"1\">\n\n  <!-- ============ FRANJA TEMPORAL ============ -->\n  <header data-name=\"franja temporal\" class=\"h-[56px] flex-none flex items-stretch border-b border-[#191D23] bg-[#0B0D10]\" data-kid=\"1-1\">\n    <div data-name=\"identidad\" class=\"flex items-center gap-3.5 pl-7 pr-6 border-r border-[#191D23]\" data-kid=\"1-1-1\">\n      <span data-name=\"marca\" class=\"flex items-end gap-[3px] h-[13px]\" data-kid=\"1-1-1-1\">\n        <i class=\"block w-[3px] h-[13px] bg-[#E6E2DA]\" data-kid=\"1-1-1-1-1\"></i>\n        <i class=\"block w-[3px] h-[8px] bg-[#4A525D]\" data-kid=\"1-1-1-1-2\"></i>\n        <i class=\"block w-[3px] h-[13px] bg-[#35D6E8]\" data-kid=\"1-1-1-1-3\"></i>\n      </span>\n      <h1 data-name=\"nombre del producto\" class=\"text-[16px] font-bold tracking-[-0.02em] leading-none\" data-kid=\"1-1-1-2\">LyAi&nbsp;·&nbsp;Prensa</h1>\n    </div>\n\n    <p data-name=\"descriptor del producto\" class=\"hidden xl:flex items-center px-6 text-[13.5px] text-[#848A92] leading-none border-r border-[#191D23]\" data-kid=\"1-1-2\">\n      Lo que cuentan los medios españoles — y cuándo no coinciden\n    </p>\n\n    <div class=\"flex-1\" data-kid=\"1-1-3\"></div>\n\n    <div data-name=\"controles de fecha\" class=\"flex items-stretch border-l border-[#191D23]\" data-kid=\"1-1-4\">\n      <button data-name=\"botón volver a hoy\" class=\"px-5 flex items-center gap-2 text-[13.5px] font-semibold text-[#08090B] bg-[#E6E2DA]\" title=\"Volver a lo más reciente\" data-kid=\"1-1-4-1\">\n        <i class=\"ph ph-arrow-counter-clockwise text-[14px]\" data-kid=\"1-1-4-1-1\"></i>HOY\n      </button>\n      <div data-name=\"fecha mostrada\" class=\"px-5 flex items-center ff-mono text-[13px] text-[#848A92] leading-none\" data-kid=\"1-1-4-2\">vie 3 oct 2026</div>\n      <button data-name=\"botón calendario\" class=\"w-[52px] flex items-center justify-center text-[#848A92] text-[17px] border-l border-[#191D23]\" data-kid=\"1-1-4-3\"><i class=\"ph ph-calendar-blank\" data-kid=\"1-1-4-3-1\"></i></button>\n      <button data-name=\"página anterior\" class=\"w-[46px] flex items-center justify-center text-[#434A54] text-[17px] border-l border-[#191D23]\" data-kid=\"1-1-4-4\"><i class=\"ph ph-caret-left\" data-kid=\"1-1-4-4-1\"></i></button>\n      <span data-name=\"número de página\" class=\"px-3 flex items-center ff-mono text-[13px] text-[#C2BEB6] leading-none border-l border-[#191D23]\" data-kid=\"1-1-4-5\">1<span class=\"text-[#434A54]\" data-kid=\"1-1-4-5-1\">&nbsp;/&nbsp;31</span></span>\n      <button data-name=\"página siguiente\" class=\"w-[46px] flex items-center justify-center text-[#E6E2DA] text-[17px] border-l border-[#191D23]\" data-kid=\"1-1-4-6\"><i class=\"ph ph-caret-right\" data-kid=\"1-1-4-6-1\"></i></button>\n    </div>\n  </header>\n\n  <!-- ============ ESCENA: ARCHIVO AL FONDO, MESA DELANTE ============ -->\n  <div data-name=\"escena\" class=\"relative flex-1 overflow-hidden\" data-kid=\"1-2\">\n\n    <!-- ---------- ARCHIVO CINÉTICO ---------- -->\n    <div data-name=\"archivo cinético\" class=\"ar-field absolute inset-0\" data-kid=\"1-2-1\">\n\n      <!-- banda lejana -->\n      <div data-name=\"banda lejana del archivo\" class=\"ar-band absolute left-0 top-[58px] flex items-center gap-10 whitespace-nowrap\" data-depth=\"0.34\" data-kid=\"1-2-1-1\">\n        <a data-name=\"titular del archivo\" href=\"#\" style=\"--medio:#2E7D9A\" class=\"ar-entry flex items-center gap-2.5 text-[13px] text-[#555B63]\" data-kid=\"1-2-1-1-1\"><span class=\"ar-swatch\" data-kid=\"1-2-1-1-1-1\"></span><span class=\"ff-mono text-[11px] tracking-[0.07em]\" data-kid=\"1-2-1-1-1-2\">LA VANGUARDIA</span>Tus hijos podrían heredar menos de lo que crees</a>\n        <a data-name=\"titular del archivo\" href=\"#\" style=\"--medio:#5B8C3A\" class=\"ar-entry flex items-center gap-2.5 text-[13px] text-[#555B63]\" data-kid=\"1-2-1-1-2\"><span class=\"ar-swatch\" data-kid=\"1-2-1-1-2-1\"></span><span class=\"ff-mono text-[11px] tracking-[0.07em]\" data-kid=\"1-2-1-1-2-2\">ELDIARIO.ES</span>Los ayuntamientos piden margen para aplicar la ley</a>\n        <a data-name=\"titular del archivo\" href=\"#\" style=\"--medio:#C9A227\" class=\"ar-entry flex items-center gap-2.5 text-[13px] text-[#555B63]\" data-kid=\"1-2-1-1-3\"><span class=\"ar-swatch\" data-kid=\"1-2-1-1-3-1\"></span><span class=\"ff-mono text-[11px] tracking-[0.07em]\" data-kid=\"1-2-1-1-3-2\">ABC</span>Las televisiones públicas compartirán la señal del domingo</a>\n        <a data-name=\"titular del archivo\" href=\"#\" style=\"--medio:#1D7A54\" class=\"ar-entry flex items-center gap-2.5 text-[13px] text-[#555B63]\" data-kid=\"1-2-1-1-4\"><span class=\"ar-swatch\" data-kid=\"1-2-1-1-4-1\"></span><span class=\"ff-mono text-[11px] tracking-[0.07em]\" data-kid=\"1-2-1-1-4-2\">EL PROGRESO</span>Tres funcionarios declaran por el criterio de reparto</a>\n        <a data-name=\"titular del archivo\" href=\"#\" style=\"--medio:#E4572E\" class=\"ar-entry flex items-center gap-2.5 text-[13px] text-[#555B63]\" data-kid=\"1-2-1-1-5\"><span class=\"ar-swatch\" data-kid=\"1-2-1-1-5-1\"></span><span class=\"ff-mono text-[11px] tracking-[0.07em]\" data-kid=\"1-2-1-1-5-2\">EUROPA PRESS</span>El Ministerio remodelará los edificios de Sant Joan</a>\n        <a data-name=\"titular del archivo\" href=\"#\" style=\"--medio:#0B6FB4\" class=\"ar-entry flex items-center gap-2.5 text-[13px] text-[#555B63]\" data-kid=\"1-2-1-1-6\"><span class=\"ar-swatch\" data-kid=\"1-2-1-1-6-1\"></span><span class=\"ff-mono text-[11px] tracking-[0.07em]\" data-kid=\"1-2-1-1-6-2\">CADENA SER</span>El pleno aprueba el presupuesto con voto de calidad</a>\n      </div>\n\n      <!-- banda media -->\n      <div data-name=\"banda media del archivo\" class=\"ar-band absolute left-0 top-[142px] flex items-center gap-10 whitespace-nowrap\" data-depth=\"0.6\" data-kid=\"1-2-1-2\">\n        <a data-name=\"titular del archivo\" href=\"#\" style=\"--medio:#F28C00\" class=\"ar-entry flex items-center gap-3 text-[14.5px] text-[#8A9098]\" data-kid=\"1-2-1-2-1\"><span class=\"ar-swatch\" data-kid=\"1-2-1-2-1-1\"></span><span class=\"ff-mono text-[11.5px] tracking-[0.07em]\" data-kid=\"1-2-1-2-1-2\">LAS PROVINCIAS</span>Lluvia de premios de la ONCE en la Comunitat</a>\n        <a data-name=\"titular del archivo\" href=\"#\" style=\"--medio:#7A1F2B\" class=\"ar-entry flex items-center gap-3 text-[14.5px] text-[#8A9098]\" data-kid=\"1-2-1-2-2\"><span class=\"ar-swatch\" data-kid=\"1-2-1-2-2-1\"></span><span class=\"ff-mono text-[11.5px] tracking-[0.07em]\" data-kid=\"1-2-1-2-2-2\">EL CORREO</span>Herida grave una mujer al caer de un quinto piso en Bilbao</a>\n        <a data-name=\"noticia con contradicción\" href=\"#\" style=\"--medio:#C8102E\" class=\"ar-entry flex items-center gap-3 text-[14.5px] text-[#C2BEB6]\" data-kid=\"1-2-1-2-3\">\n          <span class=\"ar-swatch\" data-kid=\"1-2-1-2-3-1\"></span><span class=\"ff-mono text-[11.5px] tracking-[0.07em]\" data-kid=\"1-2-1-2-3-2\">EL MUNDO</span>El Supremo resolverá el recurso antes de fin de año\n          <span data-name=\"acceso a la contradicción\" class=\"ff-mono text-[11.5px] text-[#E07A52] border border-[#5A3326] px-2 py-[3px] leading-none\" data-kid=\"1-2-1-2-3-3\">Contradice a EL CORREO · 0,3</span>\n        </a>\n        <a data-name=\"titular del archivo\" href=\"#\" style=\"--medio:#9A4DBF\" class=\"ar-entry flex items-center gap-3 text-[14.5px] text-[#8A9098]\" data-kid=\"1-2-1-2-4\"><span class=\"ar-swatch\" data-kid=\"1-2-1-2-4-1\"></span><span class=\"ff-mono text-[11.5px] tracking-[0.07em]\" data-kid=\"1-2-1-2-4-2\">EXPANSIÓN</span>El índice de referencia del alquiler sube un 2,1%</a>\n        <a data-name=\"titular del archivo\" href=\"#\" style=\"--medio:#0B6FB4\" class=\"ar-entry flex items-center gap-3 text-[14.5px] text-[#8A9098]\" data-kid=\"1-2-1-2-5\"><span class=\"ar-swatch\" data-kid=\"1-2-1-2-5-1\"></span><span class=\"ff-mono text-[11.5px] tracking-[0.07em]\" data-kid=\"1-2-1-2-5-2\">20 MINUTOS</span>Henar Álvarez estrena «Al cielo con ella»</a>\n      </div>\n\n      <!-- banda cercana: contiene el origen de la mesa -->\n      <div data-name=\"banda cercana del archivo\" class=\"ar-band absolute left-0 top-[244px] flex items-center gap-11 whitespace-nowrap\" data-depth=\"1\" data-kid=\"1-2-1-3\">\n        <span data-name=\"noticia de origen de la mesa\" style=\"--medio:#D1452E\" class=\"ar-origen flex items-center gap-3 py-2 text-[16px] text-[#F2EFE9]\" data-kid=\"1-2-1-3-1\">\n          <span class=\"ar-origen-spine\" data-kid=\"1-2-1-3-1-1\"></span>\n          <span class=\"ar-swatch-lg\" data-kid=\"1-2-1-3-1-2\"></span><span class=\"ff-mono text-[12px] tracking-[0.07em] text-[#9DA3AB]\" data-kid=\"1-2-1-3-1-3\">EL PAÍS</span>El Gobierno cifra en 2.400 millones el coste de la prórroga\n          <span data-name=\"acceso a la contradicción\" class=\"ff-mono text-[12px] text-[#08090B] bg-[#F0714A] px-2.5 py-[4px] leading-none\" data-kid=\"1-2-1-3-1-4\">Contradice a EXPANSIÓN · 0,8</span>\n        </span>\n        <a data-name=\"titular del archivo\" href=\"#\" style=\"--medio:#5B8C3A\" class=\"ar-entry flex items-center gap-3 text-[16px] text-[#C2BEB6]\" data-kid=\"1-2-1-3-2\"><span class=\"ar-swatch-lg\" data-kid=\"1-2-1-3-2-1\"></span><span class=\"ff-mono text-[12px] tracking-[0.07em]\" data-kid=\"1-2-1-3-2-2\">ELDIARIO.ES</span>Seguimos la herencia de Baldoví</a>\n        <a data-name=\"titular del archivo\" href=\"#\" style=\"--medio:#1D7A54\" class=\"ar-entry flex items-center gap-3 text-[16px] text-[#C2BEB6]\" data-kid=\"1-2-1-3-3\"><span class=\"ar-swatch-lg\" data-kid=\"1-2-1-3-3-1\"></span><span class=\"ff-mono text-[12px] tracking-[0.07em]\" data-kid=\"1-2-1-3-3-2\">LA VOZ DE GALICIA</span>La reforma del muelle de Marín entra en su última fase</a>\n        <a data-name=\"titular del archivo\" href=\"#\" style=\"--medio:#F28C00\" class=\"ar-entry flex items-center gap-3 text-[16px] text-[#C2BEB6]\" data-kid=\"1-2-1-3-4\"><span class=\"ar-swatch-lg\" data-kid=\"1-2-1-3-4-1\"></span><span class=\"ff-mono text-[12px] tracking-[0.07em]\" data-kid=\"1-2-1-3-4-2\">LAS PROVINCIAS</span>Un municipio a 15 minutos de Valencia, el más buscado</a>\n      </div>\n\n      <!-- banda con fotografía -->\n      <div data-name=\"banda fotográfica del archivo\" class=\"ar-band absolute left-0 top-[332px] flex items-stretch gap-7 whitespace-nowrap\" data-depth=\"0.78\" data-kid=\"1-2-1-4\">\n        <a data-name=\"noticia con fotografía\" href=\"#\" style=\"--medio:#0B6FB4\" class=\"flex items-center gap-4 ar-entry shrink-0\" data-kid=\"1-2-1-4-1\">\n          <img data-name=\"fotografía de la noticia\" class=\"ar-photo w-[196px] h-[112px] object-cover flex-none\" decoding=\"async\" loading=\"lazy\" alt=\"\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f1a7dcd6-f3dc-4438-b552-08241c1911d9/a4013756fa0a487185287bb27819a933.jpg\" data-kid=\"1-2-1-4-1-1\">\n          <figcaption class=\"flex flex-col gap-2 whitespace-normal w-[232px] shrink-0\" data-kid=\"1-2-1-4-1-2\">\n            <span class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-4-1-2-1\"><span class=\"ar-swatch\" data-kid=\"1-2-1-4-1-2-1-1\"></span><span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#848A92]\" data-kid=\"1-2-1-4-1-2-1-2\">RTVE</span></span>\n            <span class=\"text-[14.5px] leading-[1.3] text-[#AFABA3]\" data-kid=\"1-2-1-4-1-2-2\">El Congreso votará el viernes dos decretos de vivienda</span>\n          </figcaption>\n        </a>\n        <a data-name=\"noticia con fotografía\" href=\"#\" style=\"--medio:#C9A227\" class=\"flex items-center gap-4 ar-entry shrink-0\" data-kid=\"1-2-1-4-2\">\n          <img data-name=\"fotografía de la noticia\" class=\"ar-photo w-[196px] h-[112px] object-cover flex-none\" decoding=\"async\" loading=\"lazy\" alt=\"\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f1a7dcd6-f3dc-4438-b552-08241c1911d9/433d9d39c1124a8ea8adf9f7c950907b.jpg\" data-kid=\"1-2-1-4-2-1\">\n          <figcaption class=\"flex flex-col gap-2 whitespace-normal w-[232px] shrink-0\" data-kid=\"1-2-1-4-2-2\">\n            <span class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-4-2-2-1\"><span class=\"ar-swatch\" data-kid=\"1-2-1-4-2-2-1-1\"></span><span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#848A92]\" data-kid=\"1-2-1-4-2-2-1-2\">LA RAZÓN</span></span>\n            <span class=\"text-[14.5px] leading-[1.3] text-[#AFABA3]\" data-kid=\"1-2-1-4-2-2-2\">La organización cifró la acampada de Sol en 18.000 personas</span>\n          </figcaption>\n        </a>\n        <a data-name=\"noticia con fotografía\" href=\"#\" style=\"--medio:#E4572E\" class=\"flex items-center gap-4 ar-entry shrink-0\" data-kid=\"1-2-1-4-3\">\n          <img data-name=\"fotografía de la noticia\" class=\"ar-photo w-[196px] h-[112px] object-cover flex-none\" decoding=\"async\" loading=\"lazy\" alt=\"\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f1a7dcd6-f3dc-4438-b552-08241c1911d9/18d40f030bc441e6bf7b226b77466073.jpg\" data-kid=\"1-2-1-4-3-1\">\n          <figcaption class=\"flex flex-col gap-2 whitespace-normal w-[232px] shrink-0\" data-kid=\"1-2-1-4-3-2\">\n            <span class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-4-3-2-1\"><span class=\"ar-swatch\" data-kid=\"1-2-1-4-3-2-1-1\"></span><span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#848A92]\" data-kid=\"1-2-1-4-3-2-1-2\">EUROPA PRESS</span></span>\n            <span class=\"text-[14.5px] leading-[1.3] text-[#AFABA3]\" data-kid=\"1-2-1-4-3-2-2\">Miles de personas recorren el centro contra la reforma</span>\n          </figcaption>\n        </a>\n      </div>\n\n      <!-- banda muy lejana -->\n      <div data-name=\"banda de fondo del archivo\" class=\"ar-band absolute left-0 top-[478px] flex items-center gap-9 whitespace-nowrap\" data-depth=\"0.2\" data-kid=\"1-2-1-5\">\n        <a data-name=\"titular del archivo\" href=\"#\" style=\"--medio:#D1452E\" class=\"ar-entry flex items-center gap-2.5 text-[12.5px] text-[#3E444C]\" data-kid=\"1-2-1-5-1\"><span class=\"ar-swatch\" data-kid=\"1-2-1-5-1-1\"></span><span class=\"ff-mono text-[10.5px] tracking-[0.07em]\" data-kid=\"1-2-1-5-1-2\">EL PAÍS</span>La moratoria antidesahucios se prorroga un año más</a>\n        <a data-name=\"titular del archivo\" href=\"#\" style=\"--medio:#E4572E\" class=\"ar-entry flex items-center gap-2.5 text-[12.5px] text-[#3E444C]\" data-kid=\"1-2-1-5-2\"><span class=\"ar-swatch\" data-kid=\"1-2-1-5-2-1\"></span><span class=\"ff-mono text-[10.5px] tracking-[0.07em]\" data-kid=\"1-2-1-5-2-2\">EUROPA PRESS</span>Los fondos quedan excluidos de la vivienda protegida</a>\n        <a data-name=\"titular del archivo\" href=\"#\" style=\"--medio:#C8102E\" class=\"ar-entry flex items-center gap-2.5 text-[12.5px] text-[#3E444C]\" data-kid=\"1-2-1-5-3\"><span class=\"ar-swatch\" data-kid=\"1-2-1-5-3-1\"></span><span class=\"ff-mono text-[10.5px] tracking-[0.07em]\" data-kid=\"1-2-1-5-3-2\">EL MUNDO</span>Antifascistas se concentran contra el bloqueo de la reforma laboral</a>\n        <a data-name=\"titular del archivo\" href=\"#\" style=\"--medio:#F28C00\" class=\"ar-entry flex items-center gap-2.5 text-[12.5px] text-[#3E444C]\" data-kid=\"1-2-1-5-4\"><span class=\"ar-swatch\" data-kid=\"1-2-1-5-4-1\"></span><span class=\"ff-mono text-[10.5px] tracking-[0.07em]\" data-kid=\"1-2-1-5-4-2\">LAS PROVINCIAS</span>Los cuatro partidos que podrán verse gratis y en abierto</a>\n        <a data-name=\"titular del archivo\" href=\"#\" style=\"--medio:#9A4DBF\" class=\"ar-entry flex items-center gap-2.5 text-[12.5px] text-[#3E444C]\" data-kid=\"1-2-1-5-5\"><span class=\"ar-swatch\" data-kid=\"1-2-1-5-5-1\"></span><span class=\"ff-mono text-[10.5px] tracking-[0.07em]\" data-kid=\"1-2-1-5-5-2\">EXPANSIÓN</span>¿Peligran los beneficios de la Ley de Mecenazgo?</a>\n      </div>\n\n      <!-- banda inferior -->\n      <div data-name=\"banda inferior del archivo\" class=\"ar-band absolute left-0 top-[560px] flex items-center gap-10 whitespace-nowrap\" data-depth=\"0.48\" data-kid=\"1-2-1-6\">\n        <a data-name=\"titular del archivo\" href=\"#\" style=\"--medio:#7A1F2B\" class=\"ar-entry flex items-center gap-2.5 text-[13.5px] text-[#6B7079]\" data-kid=\"1-2-1-6-1\"><span class=\"ar-swatch\" data-kid=\"1-2-1-6-1-1\"></span><span class=\"ff-mono text-[11px] tracking-[0.07em]\" data-kid=\"1-2-1-6-1-2\">EL CORREO</span>«Me sale que gané por un punto, aunque lo vean diferente»</a>\n        <a data-name=\"titular del archivo\" href=\"#\" style=\"--medio:#F28C00\" class=\"ar-entry flex items-center gap-2.5 text-[13.5px] text-[#6B7079]\" data-kid=\"1-2-1-6-2\"><span class=\"ar-swatch\" data-kid=\"1-2-1-6-2-1\"></span><span class=\"ff-mono text-[11px] tracking-[0.07em]\" data-kid=\"1-2-1-6-2-2\">LAS PROVINCIAS</span>La serie escogida como «la mejor del siglo»</a>\n        <a data-name=\"titular del archivo\" href=\"#\" style=\"--medio:#2E7D9A\" class=\"ar-entry flex items-center gap-2.5 text-[13.5px] text-[#6B7079]\" data-kid=\"1-2-1-6-3\"><span class=\"ar-swatch\" data-kid=\"1-2-1-6-3-1\"></span><span class=\"ff-mono text-[11px] tracking-[0.07em]\" data-kid=\"1-2-1-6-3-2\">LA VANGUARDIA</span>Sanidad suspende a un centenar de restaurantes</a>\n        <a data-name=\"titular del archivo\" href=\"#\" style=\"--medio:#0B6FB4\" class=\"ar-entry flex items-center gap-2.5 text-[13.5px] text-[#6B7079]\" data-kid=\"1-2-1-6-4\"><span class=\"ar-swatch\" data-kid=\"1-2-1-6-4-1\"></span><span class=\"ff-mono text-[11px] tracking-[0.07em]\" data-kid=\"1-2-1-6-4-2\">20 MINUTOS</span>Baldoví, ante la necesidad de reorganizar el «avión»</a>\n      </div>\n\n      <!-- instrumentos del archivo, abajo a la derecha -->\n      <div data-name=\"instrumentos del archivo\" class=\"absolute right-7 bottom-6 flex flex-col items-end gap-2.5 text-right\" data-kid=\"1-2-1-7\">\n        <span data-name=\"recuento de noticias\" class=\"ff-mono text-[12.5px] text-[#6B7079] leading-none\" data-kid=\"1-2-1-7-1\">Mostrando 1 - 108 de 3330 noticias (Página 1)</span>\n        <span data-name=\"instrucción de arrastre\" class=\"flex items-center gap-2 text-[12.5px] text-[#4A5058] leading-none\" data-kid=\"1-2-1-7-2\"><i class=\"ph ph-hand-pointing text-[14px]\" data-kid=\"1-2-1-7-2-1\"></i>Pulsa un titular para traerlo a la mesa · arrastra el archivo</span>\n      </div>\n    </div>\n\n    <!-- ---------- MESA DE CONTRASTE ---------- -->\n    <aside data-name=\"mesa de contraste\" class=\"absolute left-0 top-0 bottom-0 w-[836px] bg-[#E9E5DD] text-[#15171A] flex flex-col\" data-kid=\"1-2-2\">\n\n      <div data-name=\"cabecera de la mesa\" class=\"px-11 pt-9 pb-7\" data-kid=\"1-2-2-1\">\n        <div class=\"flex items-start gap-6\" data-kid=\"1-2-2-1-1\">\n          <div class=\"flex-1\" data-kid=\"1-2-2-1-1-1\">\n            <h2 class=\"text-[31px] leading-[1.02] tracking-[-0.032em] font-bold\" data-kid=\"1-2-2-1-1-1-1\">Contradicción detectada</h2>\n            <p class=\"mt-2.5 text-[15px] text-[#5C5950]\" data-kid=\"1-2-2-1-1-1-2\">Coste de la prórroga del alquiler<span class=\"text-[#A39C8E]\" data-kid=\"1-2-2-1-1-1-2-1\"> · </span><span class=\"font-semibold text-[#A8381C]\" data-kid=\"1-2-2-1-1-1-2-2\">fuerte</span></p>\n          </div>\n          <button data-name=\"cerrar la mesa\" class=\"w-[38px] h-[38px] flex items-center justify-center border border-[#C7C0B2] text-[#5C5950] text-[16px] flex-none\" data-kid=\"1-2-2-1-1-2\"><i class=\"ph ph-x\" data-kid=\"1-2-2-1-1-2-1\"></i></button>\n        </div>\n      </div>\n\n      <div data-name=\"afirmaciones enfrentadas\" class=\"flex items-stretch px-11 border-t border-[#CFC8BA] pt-8\" data-kid=\"1-2-2-2\">\n        <div data-name=\"afirmación del primer medio\" style=\"--medio:#D1452E\" class=\"flex-1 pr-9 flex flex-col gap-4\" data-kid=\"1-2-2-2-1\">\n          <span class=\"flex items-center gap-2.5\" data-kid=\"1-2-2-2-1-1\">\n            <span class=\"ar-swatch-lg\" data-kid=\"1-2-2-2-1-1-1\"></span>\n            <span class=\"ff-mono text-[11.5px] tracking-[0.08em] text-[#5C5950]\" data-kid=\"1-2-2-2-1-1-2\">EL PAÍS</span>\n            <span class=\"ff-mono text-[11.5px] text-[#A39C8E] ml-auto\" data-kid=\"1-2-2-2-1-1-3\">30 SEP · 01:52</span>\n          </span>\n          <p class=\"ff-read text-[26px] leading-[1.26] text-[#15171A]\" data-kid=\"1-2-2-2-1-2\">«El Gobierno cifra en 2.400 millones el coste de la prórroga»</p>\n          <a data-name=\"enlace al artículo original\" href=\"#\" class=\"ff-mono text-[12.5px] text-[#0F6E7A] inline-flex items-center gap-1.5 w-fit border-b border-[#9CC4C9] pb-0.5\" data-kid=\"1-2-2-2-1-3\"><i class=\"ph ph-arrow-up-right text-[13px]\" data-kid=\"1-2-2-2-1-3-1\"></i>elpais.com</a>\n        </div>\n\n        <div data-name=\"separación entre afirmaciones\" class=\"w-px bg-[#C7C0B2] flex-none\" data-kid=\"1-2-2-2-2\"></div>\n\n        <div data-name=\"afirmación del segundo medio\" style=\"--medio:#9A4DBF\" class=\"flex-1 pl-9 flex flex-col gap-4\" data-kid=\"1-2-2-2-3\">\n          <span class=\"flex items-center gap-2.5\" data-kid=\"1-2-2-2-3-1\">\n            <span class=\"ar-swatch-lg\" data-kid=\"1-2-2-2-3-1-1\"></span>\n            <span class=\"ff-mono text-[11.5px] tracking-[0.08em] text-[#5C5950]\" data-kid=\"1-2-2-2-3-1-2\">EXPANSIÓN</span>\n            <span class=\"ff-mono text-[11.5px] text-[#A39C8E] ml-auto\" data-kid=\"1-2-2-2-3-1-3\">30 SEP · 00:39</span>\n          </span>\n          <p class=\"ff-read text-[26px] leading-[1.26] text-[#15171A]\" data-kid=\"1-2-2-2-3-2\">«El Gobierno estima el coste de la prórroga en 1.600 millones»</p>\n          <a data-name=\"enlace al artículo original\" href=\"#\" class=\"ff-mono text-[12.5px] text-[#0F6E7A] inline-flex items-center gap-1.5 w-fit border-b border-[#9CC4C9] pb-0.5\" data-kid=\"1-2-2-2-3-3\"><i class=\"ph ph-arrow-up-right text-[13px]\" data-kid=\"1-2-2-2-3-3-1\"></i>expansion.com</a>\n        </div>\n      </div>\n\n      <div data-name=\"razonamiento de la detección\" class=\"px-11 pt-9\" data-kid=\"1-2-2-3\">\n        <p class=\"ff-read text-[17px] leading-[1.58] text-[#2E3034] max-w-[660px]\" data-kid=\"1-2-2-3-1\">\n          Ambas noticias atribuyen la cifra al mismo informe presentado el jueves en el Congreso. Una recoge el coste acumulado a cuatro años y la otra el del primer ejercicio, sin que ninguna de las dos indique el periodo que está midiendo. Tal como se publican, las cantidades no son compatibles.\n        </p>\n        <p class=\"mt-3.5 text-[12.5px] text-[#7A756A] max-w-[660px]\" data-kid=\"1-2-2-3-2\">Explicación de por qué el sistema marcó el par. No es una verificación de cuál de las dos cifras es correcta.</p>\n      </div>\n\n      <div data-name=\"intensidad del desacuerdo\" class=\"px-11 pt-8 max-w-[420px]\" data-kid=\"1-2-2-4\">\n        <div class=\"flex items-baseline justify-between mb-2\" data-kid=\"1-2-2-4-1\">\n          <span class=\"ff-mono text-[11.5px] tracking-[0.08em] text-[#5C5950]\" data-kid=\"1-2-2-4-1-1\">INTENSIDAD DEL DESACUERDO</span>\n          <span class=\"ff-mono text-[13.5px] text-[#15171A]\" data-kid=\"1-2-2-4-1-2\">0,8</span>\n        </div>\n        <div class=\"ar-ruler\" data-kid=\"1-2-2-4-2\">\n          <div class=\"ar-ruler-track\" data-kid=\"1-2-2-4-2-1\"></div>\n          <div class=\"ar-ruler-tick\" style=\"left:0\" data-kid=\"1-2-2-4-2-2\"></div>\n          <div class=\"ar-ruler-tick\" style=\"left:25%\" data-kid=\"1-2-2-4-2-3\"></div>\n          <div class=\"ar-ruler-tick\" style=\"left:50%\" data-kid=\"1-2-2-4-2-4\"></div>\n          <div class=\"ar-ruler-tick\" style=\"left:75%\" data-kid=\"1-2-2-4-2-5\"></div>\n          <div class=\"ar-ruler-tick\" style=\"right:0\" data-kid=\"1-2-2-4-2-6\"></div>\n          <div class=\"ar-ruler-needle\" style=\"left:80%\" data-kid=\"1-2-2-4-2-7\"></div>\n        </div>\n        <div class=\"flex justify-between ff-mono text-[11.5px] text-[#A39C8E] mt-1\" data-kid=\"1-2-2-4-3\"><span data-kid=\"1-2-2-4-3-1\">0</span><span data-kid=\"1-2-2-4-3-2\">1</span></div>\n      </div>\n\n      <div class=\"flex-1\" data-kid=\"1-2-2-5\"></div>\n\n      <div data-name=\"otros medios que lo cuentan\" class=\"px-11 py-6 border-t border-[#CFC8BA]\" data-kid=\"1-2-2-6\">\n        <span class=\"ff-mono text-[11.5px] tracking-[0.08em] text-[#5C5950]\" data-kid=\"1-2-2-6-1\">TAMBIÉN LO CUENTAN · 4</span>\n        <div class=\"mt-3 flex flex-wrap gap-x-7 gap-y-2.5\" data-kid=\"1-2-2-6-2\">\n          <a href=\"#\" style=\"--medio:#2E7D9A\" class=\"flex items-center gap-2.5 text-[14px] text-[#2E3034]\" data-kid=\"1-2-2-6-2-1\"><span class=\"ar-swatch\" data-kid=\"1-2-2-6-2-1-1\"></span>La Vanguardia</a>\n          <a href=\"#\" style=\"--medio:#E4572E\" class=\"flex items-center gap-2.5 text-[14px] text-[#2E3034]\" data-kid=\"1-2-2-6-2-2\"><span class=\"ar-swatch\" data-kid=\"1-2-2-6-2-2-1\"></span>Europa Press</a>\n          <a href=\"#\" style=\"--medio:#5B8C3A\" class=\"flex items-center gap-2.5 text-[14px] text-[#2E3034]\" data-kid=\"1-2-2-6-2-3\"><span class=\"ar-swatch\" data-kid=\"1-2-2-6-2-3-1\"></span>eldiario.es</a>\n          <a href=\"#\" style=\"--medio:#C8102E\" class=\"flex items-center gap-2.5 text-[14px] text-[#2E3034]\" data-kid=\"1-2-2-6-2-4\"><span class=\"ar-swatch\" data-kid=\"1-2-2-6-2-4-1\"></span>El Mundo</a>\n        </div>\n      </div>\n\n      <div data-name=\"acciones de la mesa\" class=\"px-11 py-6 border-t border-[#CFC8BA] flex items-center gap-3.5\" data-kid=\"1-2-2-7\">\n        <a data-name=\"acción leer\" href=\"#\" class=\"h-[42px] px-6 inline-flex items-center gap-2 bg-[#15171A] text-[#E9E5DD] text-[14px] font-medium\" data-kid=\"1-2-2-7-1\">Leer <i class=\"ph ph-arrow-up-right text-[14px]\" data-kid=\"1-2-2-7-1-1\"></i></a>\n        <button data-name=\"acción girar\" class=\"h-[42px] px-6 inline-flex items-center gap-2 border border-[#15171A] text-[#15171A] text-[14px] font-medium\" data-kid=\"1-2-2-7-2\">Girar <i class=\"ph ph-arrow-clockwise text-[14px]\" data-kid=\"1-2-2-7-2-1\"></i></button>\n        <span data-name=\"origen de la selección\" class=\"ml-auto ff-mono text-[11.5px] text-[#7A756A] flex items-center gap-2\" data-kid=\"1-2-2-7-3\"><i class=\"ph ph-arrow-right text-[13px]\" data-kid=\"1-2-2-7-3-1\"></i>Origen marcado en el archivo</span>\n      </div>\n    </aside>\n  </div>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/Draggable.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/InertiaPlugin.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/Observer.min.js\"></script>\n<script>\n  gsap.registerPlugin(Draggable, InertiaPlugin, Observer);\n\n  const scene = document.querySelector('[data-name=\"escena\"]');\n  const bands = gsap.utils.toArray('.ar-band');\n\n  // Posición de referencia del archivo. Cada banda la aplica con su propia\n  // profundidad: las cercanas recorren más, las lejanas menos.\n  const state = { x: 0 };\n  const setters = bands.map((band) => ({\n    depth: parseFloat(band.dataset.depth || '1'),\n    set: gsap.quickSetter(band, 'x', 'px'),\n    scrollSpan: () => band.scrollWidth,\n  }));\n\n  const limit = () => -Math.max(0, Math.max(...setters.map((s) => s.scrollSpan())) - scene.clientWidth + 180);\n\n  function render() {\n    setters.forEach((s) => s.set(state.x * s.depth));\n  }\n  render();\n\n  // Un proxy real recibe el arrastre; `state.x` sigue siendo la única fuente de\n  // verdad y cada banda lo aplica con su profundidad.\n  const proxy = document.createElement('div');\n  proxy.style.cssText = 'position:absolute;left:0;top:0;width:1px;height:1px;opacity:0;pointer-events:none';\n  document.body.appendChild(proxy);\n  gsap.set(proxy, { x: state.x });\n\n  // El archivo entra quieto y empieza a derivar poco después.\n  let drifting = false;\n  let resumeDrift;\n  setTimeout(() => { drifting = true; }, 2200);\n\n  function pauseDrift() {\n    drifting = false;\n    clearTimeout(resumeDrift);\n    resumeDrift = setTimeout(() => { drifting = true; }, 2600);\n  }\n\n  function follow() {\n    state.x = gsap.utils.clamp(limit(), 0, gsap.getProperty(proxy, 'x'));\n    render();\n  }\n\n  Draggable.create(proxy, {\n    trigger: scene,\n    type: 'x',\n    inertia: true,\n    edgeResistance: 0.85,\n    allowNativeTouchScrolling: false,\n    onPress() { pauseDrift(); gsap.set(proxy, { x: state.x }); this.update(); },\n    onDrag: follow,\n    onThrowUpdate: follow,\n    onThrowComplete: pauseDrift,\n  });\n\n  // La rueda empuja el mismo eje con idéntica amortiguación.\n  Observer.create({\n    target: scene,\n    type: 'wheel',\n    onChange(self) {\n      pauseDrift();\n      const delta = (self.deltaY || 0) + (self.deltaX || 0);\n      gsap.to(state, {\n        x: gsap.utils.clamp(limit(), 0, state.x - delta * 2.2),\n        duration: 0.9,\n        ease: 'power3.out',\n        overwrite: true,\n        onUpdate: render,\n      });\n    },\n  });\n\n  // Deriva lenta y continua mientras nadie lo toca: el archivo sigue vivo detrás.\n  gsap.ticker.add(() => {\n    if (!drifting) return;\n    const next = state.x - 0.24;\n    state.x = next < limit() ? 0 : next;\n    render();\n  });\n\n  // Entrada: el archivo ya está en movimiento y la mesa se asienta sobre él.\n  gsap.from('[data-name=\"mesa de contraste\"]', {\n    xPercent: -6,\n    autoAlpha: 0,\n    duration: 0.8,\n    ease: 'power3.out',\n  });\n  gsap.from('[data-name=\"afirmación del primer medio\"] .ff-read, [data-name=\"afirmación del segundo medio\"] .ff-read', {\n    autoAlpha: 0,\n    y: 16,\n    duration: 0.65,\n    stagger: 0.1,\n    delay: 0.3,\n    ease: 'power3.out',\n  });\n  gsap.from('.ar-ruler-needle', { left: '0%', duration: 0.9, delay: 0.55, ease: 'power2.out' });\n  gsap.from('.ar-origen', { autoAlpha: 0, duration: 0.5, delay: 0.7, ease: 'power2.out' });\n</script>\n\n<script>\n  // Arrastrar no debe pulsar. Mismo umbral que `useDwell` en el repo\n  // (touchSlop = 10 px): si el puntero se mueve más que eso entre pointerdown y\n  // pointerup, el click se traga. Es el mismo guardia que `consumeTouchClick`.\n  (function () {\n    const SLOP = 10;\n    const surface = document.querySelector('[data-name=\"escena\"]');\n    let ox = 0, oy = 0, dragged = false;\n    surface.addEventListener('pointerdown', (e) => { ox = e.clientX; oy = e.clientY; dragged = false; }, true);\n    surface.addEventListener('pointermove', (e) => {\n      if (e.buttons && Math.hypot(e.clientX - ox, e.clientY - oy) > SLOP) dragged = true;\n    }, true);\n    surface.addEventListener('click', (e) => {\n      if (!dragged) return;\n      e.preventDefault();\n      e.stopPropagation();\n    }, true);\n  })();\n</script>\n",
      "type": "variant",
      "label": "B · Mesa de contraste sobre archivo cinético",
      "rect": {
        "x": 1529.6842105263158,
        "y": -2115.4736842105267,
        "w": 1440,
        "h": 800
      },
      "parentId": null,
      "id": "node_71b5219b9aa0",
      "created": "2026-10-03T04:28:17.300Z",
