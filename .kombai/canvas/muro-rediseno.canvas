    "node_a3fffd2478ba": {
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css\");\n\n.ff-grotesk { font-family: 'Archivo', system-ui, sans-serif; }\n.ff-mono { font-family: 'IBM Plex Mono', ui-monospace, monospace; }\n.ff-serif { font-family: 'Instrument Serif', Georgia, serif; }\n\n/* El campo arrastrable no debe seleccionar texto al tirar de él. */\n.lp-field, .lp-track { user-select: none; -webkit-user-select: none; }\n.lp-track { will-change: transform; cursor: grab; }\n.lp-track:active { cursor: grabbing; }\n\n/* Marca de procedencia: cuadrado del color del medio. No es una franja lateral. */\n.lp-swatch { width: 9px; height: 9px; flex: none; background: var(--medio); }\n\n/* La costura: único lugar donde dos afirmaciones se enfrentan. */\n.lp-seam { position: relative; width: 1px; background: #2A3039; flex: none; }\n.lp-seam::before,\n.lp-seam::after {\n  content: ''; position: absolute; left: -5px; width: 11px; height: 1px; background: #D9542B;\n}\n.lp-seam::before { top: 50%; margin-top: -9px; }\n.lp-seam::after { top: 50%; margin-top: 9px; }\n\n/* Regla de intensidad 0–1 con marcas reales. */\n.lp-ruler { position: relative; height: 22px; }\n.lp-ruler-track { position: absolute; left: 0; right: 0; top: 10px; height: 1px; background: #2A3039; }\n.lp-ruler-tick { position: absolute; top: 4px; width: 1px; height: 7px; background: #3A424D; }\n.lp-ruler-needle { position: absolute; top: 0; width: 1px; height: 21px; background: #F0714A; }\n.lp-ruler-needle::after {\n  content: ''; position: absolute; left: -3px; top: 0; width: 7px; height: 7px; background: #F0714A;\n}\n\n/* Grano fotográfico contenido: las fotos no deben dominar el campo. */\n\n/* Toda noticia es un destino. La canal de la izquierda es PERMANENTE: existe en\n   reposo, así que también se ve en pantalla táctil, donde no hay hover. */\n.lp-entry { position: relative; padding-left: 15px; cursor: pointer; text-decoration: none; }\n.lp-entry-flush { padding-left: 0; }\n.lp-entry::before {\n  content: ''; position: absolute; left: 0; top: 1px; bottom: 1px; width: 1px;\n  background: #272C34; transition: background .18s ease, width .18s ease;\n}\n.lp-entry:hover::before, .lp-entry:focus-visible::before { background: #ECEAE5; width: 2px; }\n.lp-entry:hover .lp-ttl { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; text-decoration-color: #6E757E; }\n.lp-entry:focus-visible { outline: 1px solid #35D6E8; outline-offset: 5px; }\n/* La noticia cuyo detalle está abierto conserva la marca sin depender del puntero. */\n.lp-entry[data-abierta]::before { background: #F0714A; width: 2px; }\n.lp-entry[data-abierta] .lp-ttl { color: #F7F5F0; }\n\n.lp-photo { filter: grayscale(0.35) contrast(1.05) brightness(0.72); }\n\n.lp-entry[data-abierta]::before { background: #ECEAE5; }\n</style>\n\n<div data-name=\"pantalla del muro\" class=\"ff-grotesk w-full h-[900px] bg-[#07080A] text-[#ECEAE5] flex flex-col overflow-hidden antialiased\" data-kid=\"1\">\n\n  <!-- ============ BARRA DE INSTRUMENTOS SUPERIOR ============ -->\n  <header data-name=\"barra superior\" class=\"h-[62px] flex-none flex items-stretch border-b border-[#1B1F26] bg-[#0A0C0F]\" data-kid=\"1-1\">\n\n    <div data-name=\"identidad\" class=\"flex items-center gap-4 pl-7 pr-6 border-r border-[#1B1F26]\" data-kid=\"1-1-1\">\n      <span data-name=\"marca de rejilla\" class=\"grid grid-cols-3 gap-[2px]\" data-kid=\"1-1-1-1\">\n        <i class=\"block w-[3px] h-[3px] bg-[#35D6E8]\" data-kid=\"1-1-1-1-1\"></i><i class=\"block w-[3px] h-[3px] bg-[#4A525D]\" data-kid=\"1-1-1-1-2\"></i><i class=\"block w-[3px] h-[3px] bg-[#4A525D]\" data-kid=\"1-1-1-1-3\"></i>\n        <i class=\"block w-[3px] h-[3px] bg-[#4A525D]\" data-kid=\"1-1-1-1-4\"></i><i class=\"block w-[3px] h-[3px] bg-[#D9542B]\" data-kid=\"1-1-1-1-5\"></i><i class=\"block w-[3px] h-[3px] bg-[#4A525D]\" data-kid=\"1-1-1-1-6\"></i>\n        <i class=\"block w-[3px] h-[3px] bg-[#4A525D]\" data-kid=\"1-1-1-1-7\"></i><i class=\"block w-[3px] h-[3px] bg-[#4A525D]\" data-kid=\"1-1-1-1-8\"></i><i class=\"block w-[3px] h-[3px] bg-[#4A525D]\" data-kid=\"1-1-1-1-9\"></i>\n      </span>\n      <h1 data-name=\"nombre del producto\" class=\"text-[17px] font-bold tracking-[-0.025em] leading-none\" data-kid=\"1-1-1-2\">LyAi&nbsp;·&nbsp;Prensa</h1>\n    </div>\n\n    <p data-name=\"descriptor del producto\" class=\"flex items-center px-6 text-[13.5px] text-[#8B9199] leading-none border-r border-[#1B1F26]\" data-kid=\"1-1-2\">\n      Lo que cuentan los medios españoles — y cuándo no coinciden\n    </p>\n\n    <div data-name=\"recuento de desacuerdos\" class=\"flex items-center gap-2.5 px-6 border-r border-[#1B1F26]\" data-kid=\"1-1-3\">\n      <span class=\"w-[9px] h-[9px] bg-[#D9542B]\" data-kid=\"1-1-3-1\"></span>\n      <span class=\"ff-mono text-[13px] text-[#C4C0B8] leading-none\" data-kid=\"1-1-3-2\">7 contradicciones en esta página</span>\n    </div>\n\n    <div class=\"flex-1\" data-kid=\"1-1-4\"></div>\n\n    <div data-name=\"controles de fecha\" class=\"flex items-stretch border-l border-[#1B1F26]\" data-kid=\"1-1-5\">\n      <button data-name=\"botón volver a hoy\" class=\"px-5 flex items-center gap-2 text-[13.5px] font-medium text-[#07080A] bg-[#ECEAE5]\" title=\"Volver a lo más reciente\" data-kid=\"1-1-5-1\">\n        <i class=\"ph ph-arrow-counter-clockwise text-[14px]\" data-kid=\"1-1-5-1-1\"></i>HOY\n      </button>\n      <div data-name=\"fecha mostrada\" class=\"px-5 flex items-center ff-mono text-[13px] text-[#8B9199] leading-none\" data-kid=\"1-1-5-2\">vie 3 oct 2026</div>\n      <button data-name=\"botón calendario\" class=\"w-[54px] flex items-center justify-center text-[#8B9199] text-[17px] border-l border-[#1B1F26]\" data-kid=\"1-1-5-3\">\n        <i class=\"ph ph-calendar-blank\" data-kid=\"1-1-5-3-1\"></i>\n      </button>\n    </div>\n\n    <div data-name=\"paginación\" class=\"flex items-stretch border-l border-[#1B1F26]\" data-kid=\"1-1-6\">\n      <button data-name=\"página anterior\" class=\"w-[48px] flex items-center justify-center text-[#454C56] text-[17px]\" data-kid=\"1-1-6-1\"><i class=\"ph ph-caret-left\" data-kid=\"1-1-6-1-1\"></i></button>\n      <span data-name=\"número de página\" class=\"px-3 flex items-center ff-mono text-[13px] text-[#C4C0B8] leading-none\" data-kid=\"1-1-6-2\">1<span class=\"text-[#454C56]\" data-kid=\"1-1-6-2-1\">&nbsp;/&nbsp;31</span></span>\n      <button data-name=\"página siguiente\" class=\"w-[48px] flex items-center justify-center text-[#ECEAE5] text-[17px] border-l border-[#1B1F26]\" data-kid=\"1-1-6-3\"><i class=\"ph ph-caret-right\" data-kid=\"1-1-6-3-1\"></i></button>\n    </div>\n  </header>\n\n  <!-- ============ CAMPO PANORÁMICO ============ -->\n  <div data-name=\"campo de titulares\" class=\"lp-field relative flex-1 overflow-hidden\" data-kid=\"1-2\">\n\n    <div data-name=\"pista arrastrable\" class=\"lp-track absolute inset-y-0 left-0 flex items-stretch\" data-kid=\"1-2-1\">\n\n      <!-- ---- tramo 1: denso, sin fotografía ---- -->\n      <section data-name=\"tramo de noticias\" class=\"lp-tramo order-1 w-[268px] flex-none px-7 py-7 flex flex-col gap-[22px] border-r border-[#14181E]\" data-kid=\"1-2-1-1\">\n        <a data-name=\"entrada de noticia\" href=\"#\" style=\"--medio:#C8102E\" class=\"lp-entry flex flex-col gap-2\" data-kid=\"1-2-1-1-1\">\n          <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-1-1-1\">\n            <span class=\"lp-swatch\" data-kid=\"1-2-1-1-1-1-1\"></span>\n            <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-1-1-1-2\">EL MUNDO</span>\n            <span class=\"ff-mono text-[11.5px] text-[#454C56] leading-none ml-auto\" data-kid=\"1-2-1-1-1-1-3\">01:52</span>\n          </div>\n          <h3 class=\"text-[15px] leading-[1.26] tracking-[-0.012em] text-[#DEDBD4] font-medium lp-ttl\" data-kid=\"1-2-1-1-1-2\">Antifascistas se concentran contra el bloqueo de la reforma laboral</h3>\n        </a>\n        <a data-name=\"entrada de noticia\" href=\"#\" style=\"--medio:#F28C00\" class=\"lp-entry flex flex-col gap-2\" data-kid=\"1-2-1-1-2\">\n          <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-1-2-1\">\n            <span class=\"lp-swatch\" data-kid=\"1-2-1-1-2-1-1\"></span>\n            <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-1-2-1-2\">LAS PROVINCIAS</span>\n            <span class=\"ff-mono text-[11.5px] text-[#454C56] leading-none ml-auto\" data-kid=\"1-2-1-1-2-1-3\">01:25</span>\n          </div>\n          <h3 class=\"text-[15px] leading-[1.26] tracking-[-0.012em] text-[#DEDBD4] font-medium lp-ttl\" data-kid=\"1-2-1-1-2-2\">Los cuatro partidos de la Nations League que podrán verse gratis y en abierto</h3>\n        </a>\n        <a data-name=\"entrada de noticia\" href=\"#\" style=\"--medio:#0B6FB4\" class=\"lp-entry flex flex-col gap-2\" data-kid=\"1-2-1-1-3\">\n          <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-1-3-1\">\n            <span class=\"lp-swatch\" data-kid=\"1-2-1-1-3-1-1\"></span>\n            <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-1-3-1-2\">20 MINUTOS</span>\n            <span class=\"ff-mono text-[11.5px] text-[#454C56] leading-none ml-auto\" data-kid=\"1-2-1-1-3-1-3\">01:27</span>\n          </div>\n          <h3 class=\"text-[15px] leading-[1.26] tracking-[-0.012em] text-[#DEDBD4] font-medium lp-ttl\" data-kid=\"1-2-1-1-3-2\">Henar Álvarez estrena «Al cielo con ella» con un mensaje para la acampada de Sol</h3>\n        </a>\n        <div class=\"h-px bg-[#14181E]\" data-kid=\"1-2-1-1-4\"></div>\n        <a data-name=\"noticia abierta en el detalle\" href=\"#\" style=\"--medio:#7A1F2B\" class=\"lp-entry flex flex-col gap-2\" data-abierta=\"1\" data-kid=\"1-2-1-1-5\">\n          <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-1-5-1\">\n            <span class=\"lp-swatch\" data-kid=\"1-2-1-1-5-1-1\"></span>\n            <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-1-5-1-2\">EL CORREO</span>\n            <span class=\"ff-mono text-[11.5px] text-[#454C56] leading-none ml-auto\" data-kid=\"1-2-1-1-5-1-3\">00:50</span>\n          </div>\n          <h3 class=\"text-[15px] leading-[1.26] tracking-[-0.012em] text-[#DEDBD4] font-medium lp-ttl\" data-kid=\"1-2-1-1-5-2\">Herida grave una mujer al caer de un quinto piso en Bilbao</h3>\n        <span data-name=\"marca de detalle abierto\" class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#ECEAE5] flex items-center gap-1.5 mt-0.5\" data-kid=\"1-2-1-1-5-3\"><i class=\"ph ph-arrow-right text-[12px]\" data-kid=\"1-2-1-1-5-3-1\"></i>DETALLE ABIERTO</span></a>\n        <a data-name=\"entrada de noticia\" href=\"#\" style=\"--medio:#1D7A54\" class=\"lp-entry flex flex-col gap-2\" data-kid=\"1-2-1-1-6\">\n          <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-1-6-1\">\n            <span class=\"lp-swatch\" data-kid=\"1-2-1-1-6-1-1\"></span>\n            <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-1-6-1-2\">EL PROGRESO</span>\n            <span class=\"ff-mono text-[11.5px] text-[#454C56] leading-none ml-auto\" data-kid=\"1-2-1-1-6-1-3\">00:44</span>\n          </div>\n          <h3 class=\"text-[15px] leading-[1.26] tracking-[-0.012em] text-[#DEDBD4] font-medium lp-ttl\" data-kid=\"1-2-1-1-6-2\">Tres funcionarios declaran por el criterio de reparto del expediente de Lugo</h3>\n        </a>\n        <a data-name=\"entrada de noticia\" href=\"#\" style=\"--medio:#D1452E\" class=\"lp-entry flex flex-col gap-2\" data-kid=\"1-2-1-1-7\">\n          <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-1-7-1\">\n            <span class=\"lp-swatch\" data-kid=\"1-2-1-1-7-1-1\"></span>\n            <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-1-7-1-2\">EL PAÍS</span>\n            <span class=\"ff-mono text-[11.5px] text-[#454C56] leading-none ml-auto\" data-kid=\"1-2-1-1-7-1-3\">00:39</span>\n          </div>\n          <h3 class=\"text-[15px] leading-[1.26] tracking-[-0.012em] text-[#DEDBD4] font-medium lp-ttl\" data-kid=\"1-2-1-1-7-2\">El Gobierno cifra en 2.400 millones el coste de la prórroga</h3>\n        </a>\n      </section>\n\n      <!-- ---- tramo 2: una noticia promovida con fotografía + cola densa ---- -->\n      <section data-name=\"tramo de noticias con fotografía\" class=\"lp-tramo order-3 w-[320px] flex-none flex flex-col border-r border-[#14181E]\" data-kid=\"1-2-1-2\">\n        <a data-name=\"noticia promovida\" href=\"#\" style=\"--medio:#0B6FB4\" class=\"lp-entry lp-entry-flush flex-none\" data-kid=\"1-2-1-2-1\">\n          <img data-name=\"fotografía de la noticia\" class=\"lp-photo w-full h-[186px] object-cover\" decoding=\"async\" loading=\"lazy\" alt=\"\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f1a7dcd6-f3dc-4438-b552-08241c1911d9/a4013756fa0a487185287bb27819a933.jpg\" data-kid=\"1-2-1-2-1-1\">\n          <div class=\"px-7 pt-5 pb-6 flex flex-col gap-2.5\" data-kid=\"1-2-1-2-1-2\">\n            <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-2-1-2-1\">\n              <span class=\"lp-swatch\" data-kid=\"1-2-1-2-1-2-1-1\"></span>\n              <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-2-1-2-1-2\">RTVE</span>\n              <span class=\"ff-mono text-[11.5px] text-[#454C56] leading-none ml-auto\" data-kid=\"1-2-1-2-1-2-1-3\">02:10</span>\n            </div>\n            <h3 class=\"text-[19px] leading-[1.16] tracking-[-0.022em] text-[#F2F0EB] font-semibold lp-ttl\" data-kid=\"1-2-1-2-1-2-2\">El Congreso votará el viernes dos decretos: alquileres y renovación automática</h3>\n            <p class=\"text-[13.5px] leading-[1.5] text-[#8B9199]\" data-kid=\"1-2-1-2-1-2-3\">Uno recoge la prórroga de los alquileres, la prohibición de compra a fondos de inversión y la moratoria antidesahucios. El otro, la renovación automática e indefinida.</p>\n          </div>\n        </a>\n        <div class=\"h-px bg-[#14181E] mx-7\" data-kid=\"1-2-1-2-2\"></div>\n        <div class=\"px-7 py-6 flex flex-col gap-[22px]\" data-kid=\"1-2-1-2-3\">\n          <a data-name=\"entrada de noticia\" href=\"#\" style=\"--medio:#E4572E\" class=\"lp-entry flex flex-col gap-2\" data-kid=\"1-2-1-2-3-1\">\n            <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-2-3-1-1\">\n              <span class=\"lp-swatch\" data-kid=\"1-2-1-2-3-1-1-1\"></span>\n              <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-2-3-1-1-2\">EUROPA PRESS</span>\n              <span class=\"ff-mono text-[11.5px] text-[#454C56] leading-none ml-auto\" data-kid=\"1-2-1-2-3-1-1-3\">01:04</span>\n            </div>\n            <h3 class=\"text-[15px] leading-[1.26] tracking-[-0.012em] text-[#DEDBD4] font-medium lp-ttl\" data-kid=\"1-2-1-2-3-1-2\">El Ministerio remodelará los edificios de Sant Joan y venderá tres solares</h3>\n          </a>\n          <a data-name=\"entrada de noticia\" href=\"#\" style=\"--medio:#C8102E\" class=\"lp-entry flex flex-col gap-2\" data-kid=\"1-2-1-2-3-2\">\n            <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-2-3-2-1\">\n              <span class=\"lp-swatch\" data-kid=\"1-2-1-2-3-2-1-1\"></span>\n              <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-2-3-2-1-2\">EL MUNDO</span>\n              <span class=\"ff-mono text-[11.5px] text-[#454C56] leading-none ml-auto\" data-kid=\"1-2-1-2-3-2-1-3\">00:58</span>\n            </div>\n            <h3 class=\"text-[15px] leading-[1.26] tracking-[-0.012em] text-[#DEDBD4] font-medium lp-ttl\" data-kid=\"1-2-1-2-3-2-2\">«Me sale que gané por un punto, aunque desde el otro lado lo vean diferente»</h3>\n          </a>\n        </div>\n      </section>\n\n      <!-- ====== RUPTURA 1 · EN REPOSO ====== -->\n      <section data-name=\"ruptura de contradicción en reposo\" class=\"lp-ruptura order-4 w-[404px] flex-none bg-[#040506] border-t-[2px] border-t-[#D9542B] flex flex-col\" data-kid=\"1-2-1-3\">\n        <div class=\"px-8 pt-7 pb-6\" data-kid=\"1-2-1-3-1\">\n          <h2 class=\"text-[21px] leading-[1.1] tracking-[-0.026em] font-bold text-[#F2F0EB]\" data-kid=\"1-2-1-3-1-1\">Contradicción detectada</h2>\n          <p class=\"mt-2 text-[14px] text-[#9A9188]\" data-kid=\"1-2-1-3-1-2\">Asistentes a la acampada de Sol<span class=\"text-[#454C56]\" data-kid=\"1-2-1-3-1-2-1\"> · </span><span class=\"text-[#F0714A]\" data-kid=\"1-2-1-3-1-2-2\">moderada</span></p>\n        </div>\n\n        <div data-name=\"afirmaciones enfrentadas\" class=\"flex-1 flex items-stretch px-8 pb-2\" data-kid=\"1-2-1-3-2\">\n          <div data-name=\"afirmación del primer medio\" style=\"--medio:#0B6FB4\" class=\"flex-1 pr-7 flex flex-col justify-center gap-3\" data-kid=\"1-2-1-3-2-1\">\n            <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-3-2-1-1\">\n              <span class=\"lp-swatch\" data-kid=\"1-2-1-3-2-1-1-1\"></span>\n              <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-3-2-1-1-2\">20 MINUTOS</span>\n            </div>\n            <p class=\"ff-serif text-[21px] leading-[1.24] text-[#E6E2DA]\" data-kid=\"1-2-1-3-2-1-2\">«La Delegación del Gobierno contabilizó 4.500 asistentes»</p>\n          </div>\n          <div data-name=\"costura entre afirmaciones\" class=\"lp-seam\" data-kid=\"1-2-1-3-2-2\"></div>\n          <div data-name=\"afirmación del segundo medio\" style=\"--medio:#C9A227\" class=\"flex-1 pl-7 flex flex-col justify-center gap-3\" data-kid=\"1-2-1-3-2-3\">\n            <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-3-2-3-1\">\n              <span class=\"lp-swatch\" data-kid=\"1-2-1-3-2-3-1-1\"></span>\n              <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-3-2-3-1-2\">LA RAZÓN</span>\n            </div>\n            <p class=\"ff-serif text-[21px] leading-[1.24] text-[#E6E2DA]\" data-kid=\"1-2-1-3-2-3-2\">«La organización cifró la acampada en 18.000 personas»</p>\n          </div>\n        </div>\n\n        <div data-name=\"intensidad del desacuerdo\" class=\"px-8 pb-7 pt-5\" data-kid=\"1-2-1-3-3\">\n          <div class=\"flex items-baseline justify-between mb-1.5\" data-kid=\"1-2-1-3-3-1\">\n            <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199]\" data-kid=\"1-2-1-3-3-1-1\">INTENSIDAD DEL DESACUERDO</span>\n            <span class=\"ff-mono text-[14px] text-[#F0714A]\" data-kid=\"1-2-1-3-3-1-2\">0,6</span>\n          </div>\n          <div class=\"lp-ruler\" data-kid=\"1-2-1-3-3-2\">\n            <div class=\"lp-ruler-track\" data-kid=\"1-2-1-3-3-2-1\"></div>\n            <div class=\"lp-ruler-tick\" style=\"left:0\" data-kid=\"1-2-1-3-3-2-2\"></div>\n            <div class=\"lp-ruler-tick\" style=\"left:25%\" data-kid=\"1-2-1-3-3-2-3\"></div>\n            <div class=\"lp-ruler-tick\" style=\"left:50%\" data-kid=\"1-2-1-3-3-2-4\"></div>\n            <div class=\"lp-ruler-tick\" style=\"left:75%\" data-kid=\"1-2-1-3-3-2-5\"></div>\n            <div class=\"lp-ruler-tick\" style=\"right:0\" data-kid=\"1-2-1-3-3-2-6\"></div>\n            <div class=\"lp-ruler-needle\" style=\"left:60%\" data-kid=\"1-2-1-3-3-2-7\"></div>\n          </div>\n          <div class=\"flex justify-between ff-mono text-[11.5px] text-[#454C56] mt-0.5\" data-kid=\"1-2-1-3-3-3\"><span data-kid=\"1-2-1-3-3-3-1\">0</span><span data-kid=\"1-2-1-3-3-3-2\">1</span></div>\n        </div>\n      </section>\n\n      <!-- ---- tramo 3 ---- -->\n      <section data-name=\"tramo de noticias\" class=\"lp-tramo order-5 w-[252px] flex-none px-7 py-7 flex flex-col gap-[22px] border-r border-[#14181E]\" data-kid=\"1-2-1-4\">\n        <a data-name=\"entrada de noticia\" href=\"#\" style=\"--medio:#F28C00\" class=\"lp-entry flex flex-col gap-2\" data-kid=\"1-2-1-4-1\">\n          <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-4-1-1\">\n            <span class=\"lp-swatch\" data-kid=\"1-2-1-4-1-1-1\"></span>\n            <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-4-1-1-2\">LAS PROVINCIAS</span>\n            <span class=\"ff-mono text-[11.5px] text-[#454C56] leading-none ml-auto\" data-kid=\"1-2-1-4-1-1-3\">00:38</span>\n          </div>\n          <h3 class=\"text-[15px] leading-[1.26] tracking-[-0.012em] text-[#DEDBD4] font-medium lp-ttl\" data-kid=\"1-2-1-4-1-2\">Lluvia de premios de la ONCE en la Comunitat: el Cuponazo y un Rasca premian con 358.959,20 euros</h3>\n        </a>\n        <a data-name=\"entrada de noticia\" href=\"#\" style=\"--medio:#F28C00\" class=\"lp-entry flex flex-col gap-2\" data-kid=\"1-2-1-4-2\">\n          <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-4-2-1\">\n            <span class=\"lp-swatch\" data-kid=\"1-2-1-4-2-1-1\"></span>\n            <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-4-2-1-2\">LAS PROVINCIAS</span>\n            <span class=\"ff-mono text-[11.5px] text-[#454C56] leading-none ml-auto\" data-kid=\"1-2-1-4-2-1-3\">00:35</span>\n          </div>\n          <h3 class=\"text-[15px] leading-[1.26] tracking-[-0.012em] text-[#DEDBD4] font-medium lp-ttl\" data-kid=\"1-2-1-4-2-2\">La serie escogida como «la mejor del siglo» que se puede ver entera en Netflix</h3>\n        </a>\n        <div class=\"h-px bg-[#14181E]\" data-kid=\"1-2-1-4-3\"></div>\n        <a data-name=\"entrada de noticia\" href=\"#\" style=\"--medio:#7A1F2B\" class=\"lp-entry flex flex-col gap-2\" data-kid=\"1-2-1-4-4\">\n          <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-4-4-1\">\n            <span class=\"lp-swatch\" data-kid=\"1-2-1-4-4-1-1\"></span>\n            <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-4-4-1-2\">EL CORREO</span>\n            <span class=\"ff-mono text-[11.5px] text-[#454C56] leading-none ml-auto\" data-kid=\"1-2-1-4-4-1-3\">00:31</span>\n          </div>\n          <h3 class=\"text-[15px] leading-[1.26] tracking-[-0.012em] text-[#DEDBD4] font-medium lp-ttl\" data-kid=\"1-2-1-4-4-2\">Un municipio a apenas 15 minutos de Valencia, el más buscado para alquilar casa</h3>\n        </a>\n        <a data-name=\"entrada de noticia\" href=\"#\" style=\"--medio:#2E7D9A\" class=\"lp-entry flex flex-col gap-2\" data-kid=\"1-2-1-4-5\">\n          <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-4-5-1\">\n            <span class=\"lp-swatch\" data-kid=\"1-2-1-4-5-1-1\"></span>\n            <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-4-5-1-2\">LA VANGUARDIA</span>\n            <span class=\"ff-mono text-[11.5px] text-[#454C56] leading-none ml-auto\" data-kid=\"1-2-1-4-5-1-3\">00:22</span>\n          </div>\n          <h3 class=\"text-[15px] leading-[1.26] tracking-[-0.012em] text-[#DEDBD4] font-medium lp-ttl\" data-kid=\"1-2-1-4-5-2\">Sanidad suspende a un centenar de restaurantes y empresas de alimentación</h3>\n        </a>\n        <a data-name=\"entrada de noticia\" href=\"#\" style=\"--medio:#9A4DBF\" class=\"lp-entry flex flex-col gap-2\" data-kid=\"1-2-1-4-6\">\n          <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-4-6-1\">\n            <span class=\"lp-swatch\" data-kid=\"1-2-1-4-6-1-1\"></span>\n            <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-4-6-1-2\">EXPANSIÓN</span>\n            <span class=\"ff-mono text-[11.5px] text-[#454C56] leading-none ml-auto\" data-kid=\"1-2-1-4-6-1-3\">00:14</span>\n          </div>\n          <h3 class=\"text-[15px] leading-[1.26] tracking-[-0.012em] text-[#DEDBD4] font-medium lp-ttl\" data-kid=\"1-2-1-4-6-2\">Baldoví, ante la necesidad de reorganizar el «avión» de Pérez</h3>\n        </a>\n      </section>\n\n      <!-- ====== RUPTURA 2 · ABIERTA ====== -->\n      <section data-name=\"lectura de una noticia sin contradicción\" class=\"lp-ruptura-abierta order-2 w-[614px] flex-none bg-[#040506] border-t-[2px] flex flex-col border-t-[#ECEAE5]\" data-kid=\"1-2-1-5\">\n        <div class=\"px-9 pt-7 pb-5\" data-name=\"cabecera de la lectura\" data-kid=\"1-2-1-5-1\">\n          <div class=\"flex items-center gap-2.5\" style=\"--medio:#7A1F2B\" data-kid=\"1-2-1-5-1-1\">\n            <span class=\"lp-swatch\" data-kid=\"1-2-1-5-1-1-1\"></span>\n            <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-5-1-1-2\">EL CORREO (PAÍS VASCO)</span>\n            <span class=\"ff-mono text-[11.5px] text-[#454C56] leading-none ml-auto\" data-kid=\"1-2-1-5-1-1-3\">30 SEP · 00:50</span>\n          </div>\n          <h2 class=\"mt-4 text-[30px] leading-[1.06] tracking-[-0.03em] font-bold text-[#F7F5F0]\" data-kid=\"1-2-1-5-1-2\">Herida grave una mujer al caer de un quinto piso en Bilbao</h2>\n        </div>\n\n        <img data-name=\"fotografía de la noticia\" class=\"lp-photo flex-1 min-h-[120px] w-full object-cover\" decoding=\"async\" loading=\"lazy\" alt=\"\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f1a7dcd6-f3dc-4438-b552-08241c1911d9/cff7a787d39e4c6894d8fd4a52617b25.jpg\" data-kid=\"1-2-1-5-2\">\n\n        <p data-name=\"resumen completo\" class=\"px-9 pt-7 text-[15.5px] leading-[1.58] text-[#BFBBB3]\" data-kid=\"1-2-1-5-3\">\n          Los servicios de emergencia trasladaron a la mujer al hospital de Basurto en estado grave sobre las once de la noche. La Ertzaintza investiga las circunstancias de la caída y de momento no descarta ninguna hipótesis. El portal permaneció acordonado durante dos horas.\n        </p>\n\n        <a data-name=\"enlace a la noticia original\" href=\"#\" class=\"mx-9 mt-6 ff-mono text-[12.5px] text-[#35D6E8] inline-flex items-center gap-1.5 w-fit\" data-kid=\"1-2-1-5-4\">\n          <i class=\"ph ph-arrow-up-right text-[13px]\" data-kid=\"1-2-1-5-4-1\"></i>elcorreo.com — leer noticia original\n        </a>\n\n        <p data-name=\"ausencia de contradicción\" class=\"px-9 pt-6 text-[13px] text-[#6E757E]\" data-kid=\"1-2-1-5-5\">\n          Sin contradicciones detectadas con otros medios para este hecho.\n        </p>\n\n        <div data-name=\"otros medios que lo cuentan\" class=\"px-9 pt-6 pb-5 border-t border-[#171B21] mt-7\" data-kid=\"1-2-1-5-6\">\n          <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199]\" data-kid=\"1-2-1-5-6-1\">TAMBIÉN LO CUENTAN · 2</span>\n          <div class=\"mt-3 flex flex-wrap gap-x-5 gap-y-2.5\" data-kid=\"1-2-1-5-6-2\">\n            <a href=\"#\" style=\"--medio:#E4572E\" class=\"flex items-center gap-2 text-[13.5px] text-[#C4C0B8]\" data-kid=\"1-2-1-5-6-2-1\"><span class=\"lp-swatch\" data-kid=\"1-2-1-5-6-2-1-1\"></span>Europa Press</a>\n            <a href=\"#\" style=\"--medio:#0B6FB4\" class=\"flex items-center gap-2 text-[13.5px] text-[#C4C0B8]\" data-kid=\"1-2-1-5-6-2-2\"><span class=\"lp-swatch\" data-kid=\"1-2-1-5-6-2-2-1\"></span>Cadena SER</a>\n          </div>\n        </div>\n\n        <div data-name=\"acciones de la lectura\" class=\"px-9 pb-7 flex items-center gap-3\" data-kid=\"1-2-1-5-7\">\n          <a data-name=\"acción leer\" href=\"#\" class=\"h-[40px] px-5 inline-flex items-center gap-2 bg-[#ECEAE5] text-[#07080A] text-[13.5px] font-medium\" data-kid=\"1-2-1-5-7-1\">Leer <i class=\"ph ph-arrow-up-right text-[14px]\" data-kid=\"1-2-1-5-7-1-1\"></i></a>\n          <button data-name=\"acción girar\" class=\"h-[40px] px-5 inline-flex items-center gap-2 border border-[#2A3039] text-[#C4C0B8] text-[13.5px] font-medium\" data-kid=\"1-2-1-5-7-2\">Girar <i class=\"ph ph-arrow-clockwise text-[14px]\" data-kid=\"1-2-1-5-7-2-1\"></i></button>\n          <button data-name=\"acción cerrar la lectura\" class=\"h-[40px] px-5 inline-flex items-center gap-2 text-[#6E757E] text-[13.5px] ml-auto\" data-kid=\"1-2-1-5-7-3\">Cerrar <i class=\"ph ph-x text-[13px]\" data-kid=\"1-2-1-5-7-3-1\"></i></button>\n        </div>\n</section>\n\n      <!-- ---- tramo 4 ---- -->\n      <section data-name=\"tramo de noticias\" class=\"lp-tramo order-7 w-[280px] flex-none px-7 py-7 flex flex-col gap-[22px] border-r border-[#14181E]\" data-kid=\"1-2-1-6\">\n        <a data-name=\"entrada de noticia\" href=\"#\" style=\"--medio:#5B8C3A\" class=\"lp-entry flex flex-col gap-2\" data-kid=\"1-2-1-6-1\">\n          <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-6-1-1\">\n            <span class=\"lp-swatch\" data-kid=\"1-2-1-6-1-1-1\"></span>\n            <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-6-1-1-2\">ELDIARIO.ES</span>\n            <span class=\"ff-mono text-[11.5px] text-[#454C56] leading-none ml-auto\" data-kid=\"1-2-1-6-1-1-3\">00:11</span>\n          </div>\n          <h3 class=\"text-[15px] leading-[1.26] tracking-[-0.012em] text-[#DEDBD4] font-medium lp-ttl\" data-kid=\"1-2-1-6-1-2\">Seguimos a la herencia de Baldoví: tierras en propiedad y euros ahorrados</h3>\n        </a>\n        <a data-name=\"entrada de noticia\" href=\"#\" style=\"--medio:#2E7D9A\" class=\"lp-entry flex flex-col gap-2\" data-kid=\"1-2-1-6-2\">\n          <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-6-2-1\">\n            <span class=\"lp-swatch\" data-kid=\"1-2-1-6-2-1-1\"></span>\n            <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-6-2-1-2\">LA VANGUARDIA</span>\n            <span class=\"ff-mono text-[11.5px] text-[#454C56] leading-none ml-auto\" data-kid=\"1-2-1-6-2-1-3\">00:07</span>\n          </div>\n          <h3 class=\"text-[15px] leading-[1.26] tracking-[-0.012em] text-[#DEDBD4] font-medium lp-ttl\" data-kid=\"1-2-1-6-2-2\">Tus hijos podrían heredar menos de lo que crees: esto dice la ley</h3>\n        </a>\n        <div class=\"h-px bg-[#14181E]\" data-kid=\"1-2-1-6-3\"></div>\n        <a data-name=\"noticia con fotografía\" href=\"#\" style=\"--medio:#C9A227\" class=\"lp-entry lp-entry-flush flex flex-col gap-3\" data-kid=\"1-2-1-6-4\">\n          <img data-name=\"fotografía de la noticia\" class=\"lp-photo w-full h-[118px] object-cover\" decoding=\"async\" loading=\"lazy\" alt=\"\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f1a7dcd6-f3dc-4438-b552-08241c1911d9/846d3581e5584b6e99a2b558f007e6d7.jpg\" data-kid=\"1-2-1-6-4-1\">\n          <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-6-4-2\">\n            <span class=\"lp-swatch\" data-kid=\"1-2-1-6-4-2-1\"></span>\n            <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-6-4-2-2\">LA RAZÓN</span>\n            <span class=\"ff-mono text-[11.5px] text-[#454C56] leading-none ml-auto\" data-kid=\"1-2-1-6-4-2-3\">23:58</span>\n          </div>\n          <h3 class=\"text-[15px] leading-[1.26] tracking-[-0.012em] text-[#DEDBD4] font-medium lp-ttl\" data-kid=\"1-2-1-6-4-3\">Sanidad cifra en 11 días la espera media en urgencias hospitalarias</h3>\n        </a>\n      </section>\n\n      <!-- ====== RUPTURA 3 · EN REPOSO, LEVE ====== -->\n      <section data-name=\"ruptura de contradicción en reposo\" class=\"lp-ruptura order-6 w-[380px] flex-none bg-[#040506] border-t-[2px] border-t-[#8C4B33] flex flex-col\" data-kid=\"1-2-1-7\">\n        <div class=\"px-8 pt-7 pb-6\" data-kid=\"1-2-1-7-1\">\n          <h2 class=\"text-[21px] leading-[1.1] tracking-[-0.026em] font-bold text-[#F2F0EB]\" data-kid=\"1-2-1-7-1-1\">Contradicción detectada</h2>\n          <p class=\"mt-2 text-[14px] text-[#9A9188]\" data-kid=\"1-2-1-7-1-2\">Plazo de la Ley de Mecenazgo<span class=\"text-[#454C56]\" data-kid=\"1-2-1-7-1-2-1\"> · </span><span class=\"text-[#C07A5E]\" data-kid=\"1-2-1-7-1-2-2\">leve</span></p>\n        </div>\n        <div data-name=\"afirmaciones enfrentadas\" class=\"flex-1 flex items-stretch px-8 pb-2\" data-kid=\"1-2-1-7-2\">\n          <div data-name=\"afirmación del primer medio\" style=\"--medio:#C8102E\" class=\"flex-1 pr-7 flex flex-col justify-center gap-3\" data-kid=\"1-2-1-7-2-1\">\n            <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-7-2-1-1\">\n              <span class=\"lp-swatch\" data-kid=\"1-2-1-7-2-1-1-1\"></span>\n              <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-7-2-1-1-2\">EL MUNDO</span>\n            </div>\n            <p class=\"ff-serif text-[20px] leading-[1.24] text-[#E6E2DA]\" data-kid=\"1-2-1-7-2-1-2\">«El Supremo resolverá el recurso antes de fin de año»</p>\n          </div>\n          <div data-name=\"costura entre afirmaciones\" class=\"lp-seam\" data-kid=\"1-2-1-7-2-2\"></div>\n          <div data-name=\"afirmación del segundo medio\" style=\"--medio:#7A1F2B\" class=\"flex-1 pl-7 flex flex-col justify-center gap-3\" data-kid=\"1-2-1-7-2-3\">\n            <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-7-2-3-1\">\n              <span class=\"lp-swatch\" data-kid=\"1-2-1-7-2-3-1-1\"></span>\n              <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-7-2-3-1-2\">EL CORREO</span>\n            </div>\n            <p class=\"ff-serif text-[20px] leading-[1.24] text-[#E6E2DA]\" data-kid=\"1-2-1-7-2-3-2\">«El Supremo aplaza la decisión hasta el primer trimestre»</p>\n          </div>\n        </div>\n        <div data-name=\"intensidad del desacuerdo\" class=\"px-8 pb-7 pt-5\" data-kid=\"1-2-1-7-3\">\n          <div class=\"flex items-baseline justify-between mb-1.5\" data-kid=\"1-2-1-7-3-1\">\n            <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199]\" data-kid=\"1-2-1-7-3-1-1\">INTENSIDAD DEL DESACUERDO</span>\n            <span class=\"ff-mono text-[14px] text-[#C07A5E]\" data-kid=\"1-2-1-7-3-1-2\">0,3</span>\n          </div>\n          <div class=\"lp-ruler\" data-kid=\"1-2-1-7-3-2\">\n            <div class=\"lp-ruler-track\" data-kid=\"1-2-1-7-3-2-1\"></div>\n            <div class=\"lp-ruler-tick\" style=\"left:0\" data-kid=\"1-2-1-7-3-2-2\"></div>\n            <div class=\"lp-ruler-tick\" style=\"left:25%\" data-kid=\"1-2-1-7-3-2-3\"></div>\n            <div class=\"lp-ruler-tick\" style=\"left:50%\" data-kid=\"1-2-1-7-3-2-4\"></div>\n            <div class=\"lp-ruler-tick\" style=\"left:75%\" data-kid=\"1-2-1-7-3-2-5\"></div>\n            <div class=\"lp-ruler-tick\" style=\"right:0\" data-kid=\"1-2-1-7-3-2-6\"></div>\n            <div class=\"lp-ruler-needle\" style=\"left:30%; background:#C07A5E\" data-kid=\"1-2-1-7-3-2-7\"></div>\n          </div>\n          <div class=\"flex justify-between ff-mono text-[11.5px] text-[#454C56] mt-0.5\" data-kid=\"1-2-1-7-3-3\"><span data-kid=\"1-2-1-7-3-3-1\">0</span><span data-kid=\"1-2-1-7-3-3-2\">1</span></div>\n        </div>\n      </section>\n\n      <!-- ---- tramo 5 ---- -->\n      <section data-name=\"tramo de noticias\" class=\"lp-tramo order-8 w-[300px] flex-none flex flex-col border-r border-[#14181E]\" data-kid=\"1-2-1-8\">\n        <div class=\"px-7 py-7 flex flex-col gap-[22px]\" data-kid=\"1-2-1-8-1\">\n          <a data-name=\"entrada de noticia\" href=\"#\" style=\"--medio:#1D7A54\" class=\"lp-entry flex flex-col gap-2\" data-kid=\"1-2-1-8-1-1\">\n            <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-8-1-1-1\">\n              <span class=\"lp-swatch\" data-kid=\"1-2-1-8-1-1-1-1\"></span>\n              <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-8-1-1-1-2\">LA VOZ DE GALICIA</span>\n              <span class=\"ff-mono text-[11.5px] text-[#454C56] leading-none ml-auto\" data-kid=\"1-2-1-8-1-1-1-3\">23:41</span>\n            </div>\n            <h3 class=\"text-[15px] leading-[1.26] tracking-[-0.012em] text-[#DEDBD4] font-medium lp-ttl\" data-kid=\"1-2-1-8-1-1-2\">La reforma del muelle de Marín entra en su última fase tras dos años de obra</h3>\n          </a>\n          <a data-name=\"entrada de noticia\" href=\"#\" style=\"--medio:#0B6FB4\" class=\"lp-entry flex flex-col gap-2\" data-kid=\"1-2-1-8-1-2\">\n            <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-8-1-2-1\">\n              <span class=\"lp-swatch\" data-kid=\"1-2-1-8-1-2-1-1\"></span>\n              <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-8-1-2-1-2\">CADENA SER</span>\n              <span class=\"ff-mono text-[11.5px] text-[#454C56] leading-none ml-auto\" data-kid=\"1-2-1-8-1-2-1-3\">23:30</span>\n            </div>\n            <h3 class=\"text-[15px] leading-[1.26] tracking-[-0.012em] text-[#DEDBD4] font-medium lp-ttl\" data-kid=\"1-2-1-8-1-2-2\">El pleno aprueba el presupuesto con el voto de calidad de la alcaldesa</h3>\n          </a>\n        </div>\n        <img data-name=\"fotografía de la noticia\" class=\"lp-photo w-full h-[150px] object-cover\" decoding=\"async\" loading=\"lazy\" alt=\"\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f1a7dcd6-f3dc-4438-b552-08241c1911d9/8d30f0b479b342018a07dd959a6f51d3.jpg\" data-kid=\"1-2-1-8-2\">\n        <div class=\"px-7 py-6 flex flex-col gap-[22px]\" data-kid=\"1-2-1-8-3\">\n          <a data-name=\"entrada de noticia\" href=\"#\" style=\"--medio:#C9A227\" class=\"lp-entry flex flex-col gap-2\" data-kid=\"1-2-1-8-3-1\">\n            <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-8-3-1-1\">\n              <span class=\"lp-swatch\" data-kid=\"1-2-1-8-3-1-1-1\"></span>\n              <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-8-3-1-1-2\">ABC</span>\n              <span class=\"ff-mono text-[11.5px] text-[#454C56] leading-none ml-auto\" data-kid=\"1-2-1-8-3-1-1-3\">23:12</span>\n            </div>\n            <h3 class=\"text-[15px] leading-[1.26] tracking-[-0.012em] text-[#DEDBD4] font-medium lp-ttl\" data-kid=\"1-2-1-8-3-1-2\">Las televisiones públicas acuerdan compartir la señal del partido del domingo</h3>\n          </a>\n        </div>\n      </section>\n\n      <!-- ---- tramo 6 ---- -->\n      <section data-name=\"tramo de noticias\" class=\"lp-tramo order-9 w-[264px] flex-none px-7 py-7 flex flex-col gap-[22px]\" data-kid=\"1-2-1-9\">\n        <a data-name=\"entrada de noticia\" href=\"#\" style=\"--medio:#D1452E\" class=\"lp-entry flex flex-col gap-2\" data-kid=\"1-2-1-9-1\">\n          <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-9-1-1\">\n            <span class=\"lp-swatch\" data-kid=\"1-2-1-9-1-1-1\"></span>\n            <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-9-1-1-2\">EL PAÍS</span>\n            <span class=\"ff-mono text-[11.5px] text-[#454C56] leading-none ml-auto\" data-kid=\"1-2-1-9-1-1-3\">22:58</span>\n          </div>\n          <h3 class=\"text-[15px] leading-[1.26] tracking-[-0.012em] text-[#DEDBD4] font-medium lp-ttl\" data-kid=\"1-2-1-9-1-2\">La moratoria antidesahucios se prorroga un año más para hogares vulnerables</h3>\n        </a>\n        <a data-name=\"entrada de noticia\" href=\"#\" style=\"--medio:#E4572E\" class=\"lp-entry flex flex-col gap-2\" data-kid=\"1-2-1-9-2\">\n          <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-9-2-1\">\n            <span class=\"lp-swatch\" data-kid=\"1-2-1-9-2-1-1\"></span>\n            <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-9-2-1-2\">EUROPA PRESS</span>\n            <span class=\"ff-mono text-[11.5px] text-[#454C56] leading-none ml-auto\" data-kid=\"1-2-1-9-2-1-3\">22:44</span>\n          </div>\n          <h3 class=\"text-[15px] leading-[1.26] tracking-[-0.012em] text-[#DEDBD4] font-medium lp-ttl\" data-kid=\"1-2-1-9-2-2\">Los fondos de inversión quedan excluidos de la compra de vivienda protegida</h3>\n        </a>\n        <div class=\"h-px bg-[#14181E]\" data-kid=\"1-2-1-9-3\"></div>\n        <a data-name=\"entrada de noticia\" href=\"#\" style=\"--medio:#9A4DBF\" class=\"lp-entry flex flex-col gap-2\" data-kid=\"1-2-1-9-4\">\n          <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-9-4-1\">\n            <span class=\"lp-swatch\" data-kid=\"1-2-1-9-4-1-1\"></span>\n            <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-9-4-1-2\">EXPANSIÓN</span>\n            <span class=\"ff-mono text-[11.5px] text-[#454C56] leading-none ml-auto\" data-kid=\"1-2-1-9-4-1-3\">22:20</span>\n          </div>\n          <h3 class=\"text-[15px] leading-[1.26] tracking-[-0.012em] text-[#DEDBD4] font-medium lp-ttl\" data-kid=\"1-2-1-9-4-2\">El índice de referencia del alquiler sube un 2,1% en el tercer trimestre</h3>\n        </a>\n        <a data-name=\"entrada de noticia\" href=\"#\" style=\"--medio:#5B8C3A\" class=\"lp-entry flex flex-col gap-2\" data-kid=\"1-2-1-9-5\">\n          <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-9-5-1\">\n            <span class=\"lp-swatch\" data-kid=\"1-2-1-9-5-1-1\"></span>\n            <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-9-5-1-2\">ELDIARIO.ES</span>\n            <span class=\"ff-mono text-[11.5px] text-[#454C56] leading-none ml-auto\" data-kid=\"1-2-1-9-5-1-3\">22:03</span>\n          </div>\n          <h3 class=\"text-[15px] leading-[1.26] tracking-[-0.012em] text-[#DEDBD4] font-medium lp-ttl\" data-kid=\"1-2-1-9-5-2\">Los ayuntamientos piden margen para aplicar la nueva ley de vivienda</h3>\n        </a>\n      </section>\n\n    </div>\n  </div>\n\n  <!-- ============ BARRA DE INSTRUMENTOS INFERIOR ============ -->\n  <footer data-name=\"barra inferior\" class=\"h-[52px] flex-none flex items-stretch border-t border-[#1B1F26] bg-[#0A0C0F]\" data-kid=\"1-3\">\n    <div data-name=\"recuento de noticias\" class=\"flex items-center px-7 ff-mono text-[12.5px] text-[#8B9199] border-r border-[#1B1F26] leading-none whitespace-nowrap\" data-kid=\"1-3-1\">\n      Mostrando 1 - 108 de 3330 noticias (Página 1)\n    </div>\n    <div data-name=\"instrucción de arrastre\" class=\"flex items-center gap-2.5 px-6 text-[13px] text-[#5E646D] border-r border-[#1B1F26] leading-none whitespace-nowrap\" data-kid=\"1-3-2\"><i class=\"ph ph-hand-pointing text-[15px]\" data-kid=\"1-3-2-1\"></i>Pulsa para abrir · arrastra para recorrer</div>\n    <div class=\"flex-1\" data-kid=\"1-3-3\"></div>\n    <div data-name=\"leyenda\" class=\"flex items-center border-l border-[#1B1F26] gap-5 px-6\" data-kid=\"1-3-4\"><span class=\"flex items-center gap-2.5 text-[13px] text-[#8B9199] leading-none whitespace-nowrap\" data-kid=\"1-3-4-1\"><span class=\"block w-[2px] h-[13px]\" style=\"background:#272C34\" data-kid=\"1-3-4-1-1\"></span>Noticia pulsable</span><span class=\"flex items-center gap-2.5 text-[13px] text-[#8B9199] leading-none whitespace-nowrap\" data-kid=\"1-3-4-2\"><span class=\"block w-[2px] h-[13px]\" style=\"background:#ECEAE5\" data-kid=\"1-3-4-2-1\"></span>Lectura abierta</span><span class=\"flex items-center gap-2.5 text-[13px] text-[#8B9199] leading-none whitespace-nowrap\" data-kid=\"1-3-4-3\"><span class=\"block w-[14px] h-[2px]\" style=\"background:#D9542B\" data-kid=\"1-3-4-3-1\"></span>Ruptura por contradicción</span></div>\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/Draggable.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/InertiaPlugin.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/Observer.min.js\"></script>\n<script>\n  gsap.registerPlugin(Draggable, InertiaPlugin, Observer);\n\n  const field = document.querySelector('.lp-field');\n  const track = document.querySelector('.lp-track');\n\n  const minX = () => Math.min(0, field.clientWidth - track.scrollWidth);\n\n  // Arrastre con inercia: la física suave que ya funcionaba en el muro WebGL.\n  const drag = Draggable.create(track, {\n    type: 'x',\n    inertia: true,\n    edgeResistance: 0.82,\n    dragResistance: 0.06,\n    bounds: { minX: minX(), maxX: 0 },\n    allowNativeTouchScrolling: false,\n  })[0];\n\n  // La rueda empuja el mismo eje, con la misma amortiguación.\n  const xTo = gsap.quickTo(track, 'x', { duration: 0.85, ease: 'power3.out' });\n  let pos = 0;\n  Observer.create({\n    target: field,\n    type: 'wheel',\n    onChangeY: (self) => {\n      pos = gsap.utils.clamp(minX(), 0, pos - self.deltaY * 2.1);\n      xTo(pos);\n    },\n    onChangeX: (self) => {\n      pos = gsap.utils.clamp(minX(), 0, pos - self.deltaX * 2.1);\n      xTo(pos);\n    },\n  });\n  drag.addEventListener('dragend', () => { pos = gsap.getProperty(track, 'x'); });\n  drag.addEventListener('throwcomplete', () => { pos = gsap.getProperty(track, 'x'); });\n\n  // Las fotografías cambian el ancho real de la pista: recalcular los límites.\n  const refreshBounds = () => drag.applyBounds({ minX: minX(), maxX: 0 });\n  window.addEventListener('load', refreshBounds);\n  window.addEventListener('resize', refreshBounds);\n\n  // Entrada del campo: los tramos y las rupturas asientan en sus posiciones reales.\n  gsap.from('.lp-tramo, .lp-ruptura, .lp-ruptura-abierta', {\n    autoAlpha: 0,\n    x: 26,\n    duration: 0.7,\n    stagger: 0.055,\n    ease: 'power3.out',\n  });\n\n  // La ruptura abierta se asienta con algo más de peso.\n  gsap.from('.lp-ruptura-abierta h2, .lp-ruptura-abierta [data-name=\"resumen completo\"]', {\n    autoAlpha: 0,\n    y: 14,\n    duration: 0.6,\n    stagger: 0.09,\n    delay: 0.35,\n    ease: 'power3.out',\n  });\n\n  // La aguja de intensidad viaja hasta su valor.\n  document.querySelectorAll('.lp-ruler-needle').forEach((needle) => {\n    gsap.from(needle, { left: '0%', duration: 0.9, delay: 0.5, ease: 'power2.out' });\n  });\n</script>\n\n<script>\n  // Arrastrar no debe pulsar. Mismo umbral que `useDwell` en el repo\n  // (touchSlop = 10 px): si el puntero se mueve más que eso entre pointerdown y\n  // pointerup, el click se traga. Es el mismo guardia que `consumeTouchClick`.\n  (function () {\n    const SLOP = 10;\n    const surface = document.querySelector('.lp-field');\n    let ox = 0, oy = 0, dragged = false;\n    surface.addEventListener('pointerdown', (e) => { ox = e.clientX; oy = e.clientY; dragged = false; }, true);\n    surface.addEventListener('pointermove', (e) => {\n      if (e.buttons && Math.hypot(e.clientX - ox, e.clientY - oy) > SLOP) dragged = true;\n    }, true);\n    surface.addEventListener('click', (e) => {\n      if (!dragged) return;\n      e.preventDefault();\n      e.stopPropagation();\n    }, true);\n  })();\n</script>\n",
