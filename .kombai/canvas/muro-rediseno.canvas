" data-kid=\"1-2-1-6-1-1\">\n            <span class=\"lp-swatch\" data-kid=\"1-2-1-6-1-1-1\"></span>\n            <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-6-1-1-2\">ELDIARIO.ES</span>\n            <span class=\"ff-mono text-[11.5px] text-[#454C56] leading-none ml-auto\" data-kid=\"1-2-1-6-1-1-3\">00:11</span>\n          </div>\n          <h3 class=\"text-[15px] leading-[1.26] tracking-[-0.012em] text-[#DEDBD4] font-medium lp-ttl\" data-kid=\"1-2-1-6-1-2\">Seguimos a la herencia de Baldoví: tierras en propiedad y euros ahorrados</h3>\n        </a>\n        <a data-name=\"entrada de noticia\" href=\"#\" style=\"--medio:#2E7D9A\" class=\"lp-entry flex flex-col gap-2\" data-kid=\"1-2-1-6-2\">\n          <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-6-2-1\">\n            <span class=\"lp-swatch\" data-kid=\"1-2-1-6-2-1-1\"></span>\n            <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-6-2-1-2\">LA VANGUARDIA</span>\n            <span class=\"ff-mono text-[11.5px] text-[#454C56] leading-none ml-auto\" data-kid=\"1-2-1-6-2-1-3\">00:07</span>\n          </div>\n          <h3 class=\"text-[15px] leading-[1.26] tracking-[-0.012em] text-[#DEDBD4] font-medium lp-ttl\" data-kid=\"1-2-1-6-2-2\">Tus hijos podrían heredar menos de lo que crees: esto dice la ley</h3>\n        </a>\n        <div class=\"h-px bg-[#14181E]\" data-kid=\"1-2-1-6-3\"></div>\n        <a data-name=\"noticia con fotografía\" href=\"#\" style=\"--medio:#C9A227\" class=\"lp-entry lp-entry-flush flex flex-col gap-3\" data-kid=\"1-2-1-6-4\">\n          <img data-name=\"fotografía de la noticia\" class=\"lp-photo w-full h-[118px] object-cover\" decoding=\"async\" loading=\"lazy\" alt=\"\" src=\"https://kombai-assets.b-cdn.net/generated_assets/f1a7dcd6-f3dc-4438-b552-08241c1911d9/846d3581e5584b6e99a2b558f007e6d7.jpg\" data-kid=\"1-2-1-6-4-1\">\n          <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-6-4-2\">\n            <span class=\"lp-swatch\" data-kid=\"1-2-1-6-4-2-1\"></span>\n            <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-6-4-2-2\">LA RAZÓN</span>\n            <span class=\"ff-mono text-[11.5px] text-[#454C56] leading-none ml-auto\" data-kid=\"1-2-1-6-4-2-3\">23:58</span>\n          </div>\n          <h3 class=\"text-[15px] leading-[1.26] tracking-[-0.012em] text-[#DEDBD4] font-medium lp-ttl\" data-kid=\"1-2-1-6-4-3\">Sanidad cifra en 11 días la espera media en urgencias hospitalarias</h3>\n        </a>\n      </section>\n\n      <!-- ====== RUPTURA 3 · EN REPOSO, LEVE ====== -->\n      <section data-name=\"ruptura de contradicción en reposo\" class=\"lp-ruptura order-6 w-[380px] flex-none bg-[#040506] border-t-[2px] border-t-[#8C4B33] flex flex-col\" data-kid=\"1-2-1-7\">\n        <div class=\"px-8 pt-7 pb-6\" data-kid=\"1-2-1-7-1\">\n          <h2 class=\"text-[21px] leading-[1.1] tracking-[-0.026em] font-bold text-[#F2F0EB]\" data-kid=\"1-2-1-7-1-1\">Contradicción detectada</h2>\n          <p class=\"mt-2 text-[14px] text-[#9A9188]\" data-kid=\"1-2-1-7-1-2\">Plazo de la Ley de Mecenazgo<span class=\"text-[#454C56]\" data-kid=\"1-2-1-7-1-2-1\"> · </span><span class=\"text-[#C07A5E]\" data-kid=\"1-2-1-7-1-2-2\">leve</span></p>\n        </div>\n        <div data-name=\"afirmaciones enfrentadas\" class=\"flex-1 flex items-stretch px-8 pb-2\" data-kid=\"1-2-1-7-2\">\n          <div data-name=\"afirmación del primer medio\" style=\"--medio:#C8102E\" class=\"flex-1 pr-7 flex flex-col justify-center gap-3\" data-kid=\"1-2-1-7-2-1\">\n            <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-7-2-1-1\">\n              <span class=\"lp-swatch\" data-kid=\"1-2-1-7-2-1-1-1\"></span>\n              <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-7-2-1-1-2\">EL MUNDO</span>\n            </div>\n            <p class=\"ff-serif text-[20px] leading-[1.24] text-[#E6E2DA]\" data-kid=\"1-2-1-7-2-1-2\">«El Supremo resolverá el recurso antes de fin de año»</p>\n          </div>\n          <div data-name=\"costura entre afirmaciones\" class=\"lp-seam\" data-kid=\"1-2-1-7-2-2\"></div>\n          <div data-name=\"afirmación del segundo medio\" style=\"--medio:#7A1F2B\" class=\"flex-1 pl-7 flex flex-col justify-center gap-3\" data-kid=\"1-2-1-7-2-3\">\n            <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-7-2-3-1\">\n              <span class=\"lp-swatch\" data-kid=\"1-2-1-7-2-3-1-1\"></span>\n              <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199] leading-none\" data-kid=\"1-2-1-7-2-3-1-2\">EL CORREO</span>\n            </div>\n            <p class=\"ff-serif text-[20px] leading-[1.24] text-[#E6E2DA]\" data-kid=\"1-2-1-7-2-3-2\">«El Supremo aplaza la decisión hasta el primer trimestre»</p>\n          </div>\n        </div>\n        <div data-name=\"intensidad del desacuerdo\" class=\"px-8 pb-7 pt-5\" data-kid=\"1-2-1-7-3\">\n          <div class=\"flex items-baseline justify-between mb-1.5\" data-kid=\"1-2-1-7-3-1\">\n            <span class=\"ff-mono text-[11.5px] tracking-[0.07em] text-[#8B9199]\" data-kid=\"1-2-1-7-3-1-1\">INTENSIDAD DEL DESACUERDO</span>\n            <span class=\"ff-mono text-[14px] text-[#C07A5E]\" data-kid=\"1-2-1-7-3-1-2\">0,3</span>\n          </div>\n          <div class=\"lp-ruler\" data-kid=\"1-2-1-7-3-2\">\n            <div class=\"lp-ruler-track\" data-kid=\"1-2-1-7-3-2-1\"></div>\n            <div class=\"lp-ruler-tick\" style=\"left:0\" data-kid=\"1-2-1-7-3-2-2\"></div>\n            <div class=\"lp-ruler-tick\" style=\"left:25%\" data-kid=\"1-2-1-7-3-2-3\"></div>\n            <div class=\"lp-ruler-tick\" style=\"left:50%\" data-kid=\"1-2-1-7-3-2-4\"></div>\n            <div class=\"lp-ruler-tick\" style=\"left:75%\" data-kid=\"1-2-1-7-3-2-5\"></div>\n            <div class=\"lp-ruler-tick\" style=\"right:0\"